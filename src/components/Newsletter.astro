---
import PageSection from "./PageSection.astro";
import Heading from './elements/Heading.astro';
import Button from './elements/Button.astro';
---

<!-- Newsletter -->
<PageSection variant="gray">
    <div class="newsletter">
      <Heading as="h2" size="2xl" serif class="mb-4">Bleiben Sie informiert</Heading>
      <p class="newsletter__text">Erhalten Sie regelmäßig wertvolle Tipps zu Versicherungen, Vorsorge und Finanzen – direkt in Ihr Postfach. Kein Spam, versprochen.</p>
      <form class="newsletter__form">
        <input type="email" class="newsletter__input" placeholder="Ihre E-Mail-Adresse" required>
        <Button type="submit">Anmelden</Button>
      </form>
    </div>
</PageSection>

<style>
  .newsletter {
    text-align: center;
    max-width: var(--container-text);
    margin: 0 auto;
  }
  .newsletter__text {
    font-size: var(--text-md);
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  .newsletter__form {
    display: flex;
    gap: 1rem;
    max-width: 500px;
    margin: 0 auto;
  }
  .newsletter__input {
    flex: 1;
    padding: 1rem 1.25rem;
    font-size: var(--text-base);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    font-family: inherit;
  }
  .newsletter__input:focus {
    outline: none;
    border-color: var(--color-primary);
  }
  @media (max-width: 1024px) {
    .newsletter__form { flex-direction: column; }
  }
</style>
