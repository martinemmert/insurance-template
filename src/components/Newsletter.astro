---
import PageSection from "./PageSection.astro";
import Heading from './elements/Heading.astro';
import Button from './elements/Button.astro';
import FormField from './elements/FormField.astro';
---

<!-- Newsletter -->
<PageSection variant="gray" contentWidth="text">
    <div class="newsletter">
      <Heading as="h2" size="2xl" serif class="mb-4">Bleiben Sie informiert</Heading>
      <p class="newsletter__text">Erhalten Sie regelmäßig wertvolle Tipps zu Versicherungen, Vorsorge und Finanzen – direkt in Ihr Postfach. Kein Spam, versprochen.</p>
      <form class="newsletter__form">
        <FormField type="email" placeholder="Ihre E-Mail-Adresse" required class="newsletter__field" />
        <Button type="submit">Anmelden</Button>
      </form>
    </div>
</PageSection>

<style>
  .newsletter {
    text-align: center;
  }
  .newsletter__text {
    font-size: var(--text-md);
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  .newsletter__form {
    display: flex;
    gap: 1rem;
    max-width: 500px;
    margin: 0 auto;
  }
  .newsletter__field {
    flex: 1;
    margin-bottom: 0;
  }
  @media (max-width: 1024px) {
    .newsletter__form { flex-direction: column; }
  }
</style>
