---
import PageSection from "./PageSection.astro";
import Heading from './elements/Heading.astro';
import Text from './elements/Text.astro';
import Grid from './Grid.astro';
---

<!-- Offset Cards -->
<PageSection variant="white" label="Fakten" title="Zahlen, die für sich sprechen">
    <Grid columns={3} class="offset-cards">
      <div class="offset-card">
        <div class="offset-card__number">97%</div>
        <Heading as="h3" size="xl" class="mb-2">Erfolgsquote</Heading>
        <Text size="sm" muted class="offset-card__text">bei der Durchsetzung von Schadensfällen gegenüber Versicherungen.</Text>
      </div>
      <div class="offset-card">
        <div class="offset-card__number">24h</div>
        <Heading as="h3" size="xl" class="mb-2">Reaktionszeit</Heading>
        <Text size="sm" muted class="offset-card__text">im Schadensfall – schnelle Hilfe, wenn Sie sie am meisten brauchen.</Text>
      </div>
      <div class="offset-card">
        <div class="offset-card__number">∅ 18%</div>
        <Heading as="h3" size="xl" class="mb-2">Ersparnis</Heading>
        <Text size="sm" muted class="offset-card__text">sparen meine Kunden durchschnittlich bei gleicher oder besserer Leistung.</Text>
      </div>
    </Grid>
</PageSection>

<style>
  .offset-cards {
    padding-top: 2rem;
  }
  .offset-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    transition: transform var(--transition-normal);
  }
  .offset-card:nth-child(2) {
    transform: translateY(-2rem);
  }
  .offset-card:hover {
    transform: translateY(-0.5rem);
  }
  .offset-card:nth-child(2):hover {
    transform: translateY(-2.5rem);
  }
  .offset-card__number {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  @media (max-width: 1024px) {
    .offset-card:nth-child(2) { transform: none; }
    .offset-card:nth-child(2):hover { transform: translateY(-0.5rem); }
  }
</style>
