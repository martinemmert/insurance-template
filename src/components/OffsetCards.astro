---
import PageSection from "./PageSection.astro";
import StatCard from './elements/StatCard.astro';
import Grid from './Grid.astro';
---

<!-- Offset Cards -->
<PageSection variant="white" label="Fakten" title="Zahlen, die für sich sprechen">
    <Grid columns={3} class="offset-cards">
      <StatCard class="offset-card p-8" stat="97%" title="Erfolgsquote" description="bei der Durchsetzung von Schadensfällen gegenüber Versicherungen." />
      <StatCard class="offset-card p-8" stat="24h" title="Reaktionszeit" description="im Schadensfall – schnelle Hilfe, wenn Sie sie am meisten brauchen." />
      <StatCard class="offset-card p-8" stat="∅ 18%" title="Ersparnis" description="sparen meine Kunden durchschnittlich bei gleicher oder besserer Leistung." />
    </Grid>
</PageSection>

<style>
  .offset-cards {
    padding-top: 2rem;
  }
  .offset-card {
    box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    transition: transform var(--transition-normal);
  }
  .offset-card:nth-child(2) {
    transform: translateY(-2rem);
  }
  .offset-card:hover {
    transform: translateY(-0.5rem);
  }
  .offset-card:nth-child(2):hover {
    transform: translateY(-2.5rem);
  }

  @media (max-width: 1024px) {
    .offset-card:nth-child(2) { transform: none; }
    .offset-card:nth-child(2):hover { transform: translateY(-0.5rem); }
  }
</style>
