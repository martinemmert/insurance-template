---
import PageSection from "./PageSection.astro";
import Grid from './Grid.astro';
import ServiceCard from './elements/ServiceCard.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<!-- Produkte -->
<PageSection label="Leistungen" title="Ihr Schutz  - Baustein für Baustein" id="leistungen">
    <Grid columns={3}>
      <ServiceCard
        title="Kranken-Vollversicherung"
        description="Freie Arztwahl, kurze Wartezeiten und ein Tarif, der langfristig zu Ihrem Leben passt  - nicht nur im ersten Jahr."
        image="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=600&h=400&fit=crop"
        imageAlt="Arztgespräch"
        href={`${base}leistungen/kranken-vollversicherung`}
      />
      <ServiceCard
        title="Zahnzusatz"
        description="Bis zu 100 % Erstattung für Zahnersatz, Implantate und professionelle Zahnreinigung. Damit der nächste Zahnarztbesuch keine Kostenfrage wird."
        image="https://images.unsplash.com/photo-1606811841689-23dfddce3e95?w=600&h=400&fit=crop"
        imageAlt="Zahnbehandlung"
        href={`${base}leistungen/zahnzusatz`}
      />
      <ServiceCard
        title="Chefarzt & Zweibettzimmer"
        description="Im Krankenhaus zählt Vertrauen. Mit Wahlleistungen entscheiden Sie selbst, wer Sie behandelt und wie Sie untergebracht sind."
        image="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=600&h=400&fit=crop"
        imageAlt="Krankenhaus"
        href={`${base}leistungen/wahlleistungen-krankenhaus`}
      />
      <ServiceCard
        title="Brillen & Heilpraktiker"
        description="Sehhilfen, Kontaktlinsen, alternative Heilmethoden  - Leistungen, bei denen die GKV oft passen muss. Privat sinnvoll ergänzt."
        image="https://images.unsplash.com/photo-1577400983943-874919eca6ce?w=600&h=400&fit=crop"
        imageAlt="Brille und Sehhilfe"
        href={`${base}leistungen/brillen-heilpraktiker`}
      />
      <ServiceCard
        title="Pflegeabsicherung"
        description="Damit Sie im Pflegefall nicht auf die Grundversorgung angewiesen sind, sondern selbst entscheiden, wie und wo Sie betreut werden."
        image="https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?w=600&h=400&fit=crop"
        imageAlt="Pflegevorsorge"
        href={`${base}leistungen/pflegeabsicherung`}
      />
    </Grid>
</PageSection>
