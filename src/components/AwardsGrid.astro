---
import PageSection from "./PageSection.astro";
import Heading from './elements/Heading.astro';
import Grid from './Grid.astro';
---

<PageSection variant="gray" label="Auszeichnungen" title="Qualität, die anerkannt wird">
    <Grid columns={4} mobileColumns={2}>
      <div class="award-card">
        <div class="award-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
        </div>
        <Heading as="h3" size="md" class="mb-1">Top Versicherungsmakler</Heading>
        <p class="award-card__year">Focus Money 2023</p>
      </div>
      <div class="award-card">
        <div class="award-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
        </div>
        <Heading as="h3" size="md" class="mb-1">Exzellente Beratung</Heading>
        <p class="award-card__year">TÜV Rheinland</p>
      </div>
      <div class="award-card">
        <div class="award-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        </div>
        <Heading as="h3" size="md" class="mb-1">Kundenzufriedenheit</Heading>
        <p class="award-card__year">ProvenExpert 2024</p>
      </div>
      <div class="award-card">
        <div class="award-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <Heading as="h3" size="md" class="mb-1">IHK Zertifizierung</Heading>
        <p class="award-card__year">Fachwirt (IHK)</p>
      </div>
    </Grid>
</PageSection>

<style>
  .award-card {
    text-align: center;
    padding: 2rem;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }
  .award-card__icon {
    width: 4rem;
    height: 4rem;
    margin: 0 auto 1rem;
    background: linear-gradient(135deg, var(--color-star) 0%, #f59e0b 100%);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
  }
  .award-card__year {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

</style>
