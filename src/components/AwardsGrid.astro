---
import PageSection from "./PageSection.astro";
import AwardCard from './elements/AwardCard.astro';
import Grid from './Grid.astro';
---

<PageSection variant="gray" label="Auszeichnungen" title="Qualität, die anerkannt wird">
    <Grid columns={4} mobileColumns={2}>
      <AwardCard title="Top Versicherungsmakler" subtitle="Focus Money 2023">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
      </AwardCard>
      <AwardCard title="Exzellente Beratung" subtitle="TÜV Rheinland">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
      </AwardCard>
      <AwardCard title="Kundenzufriedenheit" subtitle="ProvenExpert 2024">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </AwardCard>
      <AwardCard title="IHK Zertifizierung" subtitle="Fachwirt (IHK)">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      </AwardCard>
    </Grid>
</PageSection>
