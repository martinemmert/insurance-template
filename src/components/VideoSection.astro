---
import PageSection from "./PageSection.astro";
---

<!-- Video Section -->
<PageSection variant="white">
    <div class="video-section">
      <div class="video-placeholder">
        <img src="https://images.unsplash.com/photo-1553877522-43269d4ea984?w=800&h=450&fit=crop" alt="Beratungsvideo" class="video-placeholder__image">
        <div class="video-placeholder__play">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
        </div>
      </div>
      <div class="video-content">
        <h2 class="video-content__title">Lernen Sie mich kennen</h2>
        <p class="video-content__text">In diesem kurzen Video erkläre ich Ihnen, wie ich arbeite und warum unabhängige Beratung einen echten Unterschied macht.</p>
        <ul class="video-content__list">
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Meine Philosophie: Zuhören, verstehen, beraten
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Warum ich mich für die Selbstständigkeit entschieden habe
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Was Sie von einer Zusammenarbeit erwarten können
          </li>
        </ul>
      </div>
    </div>
</PageSection>

<style>
  .video-section {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .video-placeholder {
    position: relative;
    aspect-ratio: 16/9;
    background: var(--color-bg-dark);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .video-placeholder__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
  }
  .video-placeholder__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 5rem;
    height: 5rem;
    background: var(--color-white);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform var(--transition-fast);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }
  .video-placeholder__play:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }
  .video-placeholder__play svg {
    margin-left: 4px;
    color: var(--color-primary);
  }
  .video-content__title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: var(--font-bold);
    margin-bottom: 1rem;
  }
  .video-content__text {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    line-height: var(--leading-relaxed);
  }
  .video-content__list {
    list-style: none;
  }
  .video-content__list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: var(--text-base);
    color: #333;
  }
  .video-content__list li svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .video-section { grid-template-columns: 1fr; }
  }
</style>
