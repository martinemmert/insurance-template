---
import Grid from './Grid.astro';
import Heading from './elements/Heading.astro';
import Text from './elements/Text.astro';
import Button from './elements/Button.astro';
import Label from './elements/Label.astro';
import Stat from './elements/Stat.astro';
---

<!-- Hero -->
<section class="hero">
  <Grid columns={2} gap="4rem" align="center" class="hero__container">
    <div class="hero__content">
      <Label class="mb-4">PKV-Experte in Aschaffenburg</Label>
      <Heading as="h1" size="hero" serif class="mb-6">Gut beraten. Rundum versorgt.</Heading>
      <Text size="lg" class="hero__text mb-8">Sie suchen jemanden, der Ihre Situation wirklich versteht  - und sich persönlich um Ihre private Krankenversicherung (PKV) kümmert? Bei mir sind Sie in guten Händen. Ich nehme mir Zeit für Sie und finde die Absicherung, die zu Ihrem Leben passt.</Text>
      <div class="hero__buttons">
        <Button href="#kontakt">Kostenloses Erstgespräch</Button>
        <Button href="#leistungen" variant="secondary">Leistungen entdecken</Button>
      </div>
    </div>
    <div class="hero__image">
      <img src="https://images.unsplash.com/photo-1607511541601-3c3772d4f79e?w=800&h=600&fit=crop" alt="Schloss Johannisburg in Aschaffenburg">
      <div class="hero__stats">
        <Stat value="30+" label="Jahre Erfahrung" />
        <Stat value="300+" label="Produktpartner" />
      </div>
    </div>
  </Grid>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 4rem 6rem;
    background: linear-gradient(135deg, var(--color-bg-warm) 0%, var(--color-bg-warm-alt) 100%);
  }
  .hero__container {
    max-width: var(--container-max);
    margin: 0 auto;
  }
  .hero__content :global(.heading) {
    line-height: var(--leading-tight);
  }
  .hero__text {
    max-width: 500px;
  }
  .hero__buttons {
    display: flex;
    gap: 1rem;
  }
  .hero__image {
    position: relative;
  }
  .hero__image img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
  }
  .hero__stats {
    position: absolute;
    bottom: -2rem;
    left: -2rem;
    display: flex;
    gap: 1.5rem;
    background: var(--color-white);
    padding: 1.5rem 2rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  @media (max-width: 1024px) {
    .hero { padding: 6rem 2rem 4rem; }
    .hero__image { display: none; }
    .hero__buttons { flex-direction: column; }
  }
</style>
