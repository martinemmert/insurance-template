---
import Grid from './Grid.astro';
import PageSection from "./PageSection.astro";
import Heading from './elements/Heading.astro';
import Text from './elements/Text.astro';
---

<!-- Checklist Section -->
<PageSection variant="white">
    <Grid columns={2} gap="4rem" align="center" class="checklist-section">
      <div>
        <div class="section__label">Erstgespräch</div>
        <Heading as="h2" size="2xl" serif class="mb-4">Was Sie zum ersten Termin mitbringen sollten</Heading>
        <Text class="split-content__text mb-6">Je besser ich Ihre aktuelle Situation verstehe, desto gezielter kann ich Sie beraten. Diese Unterlagen helfen dabei:</Text>
        <ul class="checklist">
          <li class="checklist__item">
            <div class="checklist__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div>
              <div class="checklist__title">Bestehende Versicherungspolicen</div>
              <p class="checklist__text">Alle aktuellen Verträge, die Sie haben – auch wenn Sie unsicher sind, ob sie relevant sind.</p>
            </div>
          </li>
          <li class="checklist__item">
            <div class="checklist__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div>
              <div class="checklist__title">Gehaltsnachweis oder Einkommensbescheid</div>
              <p class="checklist__text">Für die Berechnung der optimalen Absicherungshöhe und Beiträge.</p>
            </div>
          </li>
          <li class="checklist__item">
            <div class="checklist__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div>
              <div class="checklist__title">Fragen und Anliegen</div>
              <p class="checklist__text">Notieren Sie sich vorab, was Ihnen wichtig ist und welche Fragen Sie haben.</p>
            </div>
          </li>
        </ul>
      </div>
      <div class="split-content__image">
        <img src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=600&h=500&fit=crop" alt="Dokumente vorbereiten">
      </div>
    </Grid>
</PageSection>

<style>
  .checklist {
    list-style: none;
  }
  .checklist__item {
    display: flex;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .checklist__item:last-child {
    border-bottom: none;
  }
  .checklist__icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    background: var(--color-primary-bg);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }
  .checklist__title {
    font-weight: var(--font-bold);
    margin-bottom: 0.25rem;
  }
  .checklist__text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .split-content__image {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .split-content__image img {
    width: 100%;
    height: 400px;
    object-fit: cover;
  }

</style>
