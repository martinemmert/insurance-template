---
import { render, getEntry } from 'astro:content';
import Grid from './Grid.astro';
import PageSection from "./PageSection.astro";
import Heading from "./elements/Heading.astro";
import Label from './elements/Label.astro';
import Stat from './elements/Stat.astro';
import Paragraph from "./elements/Paragraph.astro";
import Image from "./elements/Image.astro";
import Divider from "./elements/Divider.astro";

const entry = await getEntry('sections', 'about');
const { Content } = await render(entry);
---

<PageSection variant="gray">
    <Grid columns={2} gap="4rem" align="center">
        <Image src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=600&h=700&fit=crop" alt="Helmut Emmert" height="500px" />
        <div>
            {entry.data.label && <Label>{entry.data.label}</Label>}
            {entry.data.title && <Heading as="h2" size="3xl" serif class="mb-2">{entry.data.title}</Heading>}
            <Content components={{ p: Paragraph }} />
            <Divider />
            <Grid columns={3} gap="2rem">
                <Stat value="30+" label="Jahre Branchenerfahrung"/>
                <Stat value="300+" label="Produktpartner"/>
                <Stat value="100%" label="Unabhängig"/>
            </Grid>
        </div>
    </Grid>
</PageSection>
