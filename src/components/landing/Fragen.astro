---
export interface Frage {
  frage: string;
  antwort: string;
}

interface Props {
  fragen?: Frage[];
}

const pkvFragen: Frage[] = [
  {
    frage: 'Kann ich später zurück in die gesetzliche Kasse?',
    antwort:
      'Nur unter bestimmten Voraussetzungen, etwa wenn Ihr Gehalt als Angestellte wieder unter die Versicherungspflichtgrenze fällt. Ab 55 bleiben Sie in der Regel privat versichert. Deshalb nehmen wir uns für diese Entscheidung gemeinsam Zeit.',
  },
  {
    frage: 'Wie entwickeln sich die Beiträge im Alter?',
    antwort:
      'Ein Teil Ihres Beitrags fließt in Altersrückstellungen, die spätere Anpassungen abfedern. Dazu planen wir von Anfang an mit: ein solide kalkulierter Tarif plus Bausteine, die Ihren Beitrag im Ruhestand senken.',
  },
  {
    frage: 'Was ist mit meiner Familie?',
    antwort:
      'In der PKV braucht jeder einen eigenen Vertrag, eine kostenlose Familienversicherung gibt es nicht. Ob Ihre Kinder privat oder gesetzlich versichert werden, hängt davon ab, wie Ihr Partner versichert ist und wer mehr verdient. Das rechnen wir gemeinsam durch.',
  },
  {
    frage: 'Ich habe Vorerkrankungen. Lohnt sich das trotzdem?',
    antwort:
      'Vorerkrankungen gehören vollständig in den Antrag, und jeder Versicherer geht anders damit um. Aus 25 Jahren Erfahrung weiß ich, wo Ihre Anfrage gute Chancen hat, und begleite Sie durch die Gesundheitsfragen.',
  },
  {
    frage: 'Mein PKV-Beitrag ist gestiegen. Was kann ich tun?',
    antwort:
      'Sie können bei Ihrem Versicherer in einen anderen Tarif wechseln (§ 204 VVG) und nehmen Ihre Altersrückstellungen mit. Welcher Tarif gut zu Ihnen passt, schauen wir uns gemeinsam an.',
  },
  {
    frage: 'Was kostet das Erstgespräch?',
    antwort: 'Nichts. 15 Minuten, per Telefon oder Video, ohne Verpflichtung.',
  },
];

const { fragen = pkvFragen } = Astro.props;
---

<section class="section faq" id="fragen" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <h2 id="faq-title">Häufige Fragen</h2>
    <div class="faq__list">
      {fragen.map((f) => (
        <details>
          <summary>{f.frage}</summary>
          <p>{f.antwort}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem 4rem;
    align-items: start;
  }

  .faq__list {
    border-top: 1px solid var(--ink);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    font-weight: 500;
    font-size: var(--step-0);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    flex-shrink: 0;
    width: 1.5rem;
    font-size: var(--step-1);
    line-height: 1;
    text-align: center;
    color: var(--green);
  }

  details[open] summary::after {
    content: '–';
  }

  summary:hover {
    color: var(--green-dark);
  }

  details p {
    padding-bottom: 1.5rem;
    color: var(--ink-soft);
  }

  @media (max-width: 56rem) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
