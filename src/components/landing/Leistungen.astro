---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const weitere = [
  {
    titel: 'Zahnzusatz',
    text: 'Bis zu 100 % Erstattung für Zahnersatz, Implantate und professionelle Zahnreinigung. Damit der nächste Zahnarztbesuch keine Kostenfrage wird.',
    href: `${base}leistungen/zahnzusatz`,
    icon: 'M12 3c-2.2 0-3.3 1-4.8 1C5 4 4 5.6 4 8c0 3 1.2 5 1.8 8.2.4 2.2 1 4.8 2.3 4.8 1.6 0 1.6-3.5 2.4-5.4.4-1 .9-1.6 1.5-1.6s1.1.6 1.5 1.6c.8 1.9.8 5.4 2.4 5.4 1.3 0 1.9-2.6 2.3-4.8C18.8 13 20 11 20 8c0-2.4-1-4-3.2-4-1.5 0-2.6-1-4.8-1z',
  },
  {
    titel: 'Chefarzt & Zweibettzimmer',
    text: 'Im Krankenhaus zählt Vertrauen. Mit Wahlleistungen entscheiden Sie selbst, wer Sie behandelt und wie Sie untergebracht sind.',
    href: `${base}leistungen/wahlleistungen-krankenhaus`,
    icon: 'M3 21V8l9-5 9 5v13M9 21v-6h6v6M12 7v4M10 9h4',
  },
  {
    titel: 'Brillen & Heilpraktiker',
    text: 'Sehhilfen, Kontaktlinsen, alternative Heilmethoden: Leistungen, bei denen die gesetzliche Kasse oft passen muss. Privat sinnvoll ergänzt.',
    href: `${base}leistungen/brillen-heilpraktiker`,
    icon: 'M2 14a4 4 0 1 0 8 0 4 4 0 1 0-8 0M14 14a4 4 0 1 0 8 0 4 4 0 1 0-8 0M10 14c.6-.8 1.3-1 2-1s1.4.2 2 1M2 14l2-7h2M22 14l-2-7h-2',
  },
  {
    titel: 'Pflegeabsicherung',
    text: 'Damit Sie im Pflegefall nicht auf die Grundversorgung angewiesen sind, sondern selbst entscheiden, wie und wo Sie betreut werden.',
    href: `${base}leistungen/pflegeabsicherung`,
    icon: 'M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z',
  },
];
---

<section class="section section--warm services" id="leistungen" aria-labelledby="services-title">
  <div class="wrap">
    <div class="services__head">
      <h2 id="services-title">Ihr Schutz, Baustein für Baustein</h2>
      <p class="lead">
        Mein Schwerpunkt ist die private Krankenversicherung. Wer gesetzlich versichert bleibt,
        bekommt bei mir die Zusatzversicherungen, die die Lücken der Kasse schließen.
      </p>
    </div>

    <div class="services__grid">
      <article class="services__main">
        <p class="services__badge">Mein Schwerpunkt</p>
        <h3>Private Krankenversicherung</h3>
        <p>
          Freie Arztwahl, kurze Wartezeiten und ein Tarif, der langfristig zu Ihrem Leben passt,
          nicht nur im ersten Jahr. Für Selbstständige, Beamte und Angestellte über der Versicherungspflichtgrenze,
          und für alle, deren PKV-Beitrag zu stark gestiegen ist.
        </p>
        <ul>
          <li>Vergleich von über 300 Versicherern</li>
          <li>Tarifwechsel bei Beitragserhöhung (§ 204 VVG)</li>
          <li>Begleitung bei Erstattungen und Leistungsfällen</li>
        </ul>
        <div class="services__main-actions">
          <a class="button services__main-button" href="#pkv-check">Zum PKV-Check</a>
          <a class="services__main-link" href={`${base}leistungen/kranken-vollversicherung`}>Mehr zur Vollversicherung</a>
        </div>
      </article>

      {weitere.map((w) => (
        <article class="services__card">
          <span class="services__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={w.icon} /></svg>
          </span>
          <h3><a href={w.href}>{w.titel}</a></h3>
          <p>{w.text}</p>
          <span class="services__more" aria-hidden="true">Mehr erfahren</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .services__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 1.25rem;
  }

  .services__main {
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    background: var(--green);
    color: var(--paper);
    border-radius: var(--radius-lg);
  }

  .services__badge {
    align-self: flex-start;
    padding: 0.3rem 0.8rem;
    background: rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 600;
  }

  .services__main h3 {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: 0;
  }

  .services__main p {
    color: rgba(255, 255, 255, 0.85);
  }

  .services__main ul {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .services__main li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .services__main li::before {
    content: '';
    flex-shrink: 0;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--green-light);
    transform: translateY(-0.1em);
  }

  .services__main-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .services__main-button {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--green);
  }

  .services__main-button:hover {
    background: var(--green-tint);
    border-color: var(--green-tint);
  }

  .services__main-link {
    color: var(--paper);
    font-weight: 600;
    text-underline-offset: 0.25em;
  }

  .services__main :focus-visible {
    outline-color: var(--paper);
  }

  .services__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: box-shadow 0.2s, border-color 0.2s;
  }

  .services__card:hover {
    border-color: transparent;
    box-shadow: var(--shadow-lg);
  }

  .services__card:has(a:focus-visible) {
    outline: 3px solid var(--green);
    outline-offset: 3px;
  }

  .services__card h3 a {
    text-decoration: none;
  }

  /* whole card is clickable via the heading link */
  .services__card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .services__card h3 a:focus-visible {
    outline: none;
  }

  .services__card p {
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .services__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--green-tint);
    color: var(--green);
    border-radius: var(--radius);
  }

  .services__more {
    margin-top: auto;
    color: var(--green);
    font-weight: 600;
    font-size: var(--step--1);
  }

  @media (max-width: 64rem) {
    .services__head {
      grid-template-columns: 1fr;
    }

    .services__grid {
      grid-template-columns: 1fr 1fr;
    }

    .services__main {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @media (max-width: 40rem) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
