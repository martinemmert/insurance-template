---
import { Image } from 'astro:assets';
import buero from '../../assets/photos/helmut-buero.jpeg';

const zusagen = [
  {
    titel: 'Ehrlich, auch ohne Abschluss',
    text: 'Passt die gesetzliche Kasse besser zu Ihnen, sage ich Ihnen das offen.',
    icon: 'M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4 12 14.01l-3-3',
  },
  {
    titel: 'Ihr Tarif, nicht meiner',
    text: 'Kein Hausversicherer, keine Vorgaben. Ich empfehle, was zu Ihnen passt.',
    icon: 'M12 2 2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
  },
  {
    titel: 'Immer derselbe Ansprechpartner',
    text: 'Telefon, Video oder mein Büro in Aschaffenburg. Sie erreichen immer mich.',
    icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
  },
  {
    titel: 'Auch nach der Unterschrift',
    text: 'Jährlicher Check, Hilfe bei Erstattungen und ein offenes Ohr, wenn Nachwuchs, Jobwechsel oder Ruhestand anstehen.',
    icon: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 6v6l4 2',
  },
];
---

<section class="section about" id="ueber-mich" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <figure class="about__photo">
      <Image
        src={buero}
        alt="Helmut Emmert in seinem Büro in Aschaffenburg"
        widths={[640, 960, 1280]}
        sizes="(max-width: 56rem) 100vw, 55vw"
      />
    </figure>

    <div class="about__text">
      <h2 id="about-title">Ich kenne den Weg. Und ich gehe ihn gern mit Ihnen.</h2>
      <p>
        25 Jahre lang habe ich bei Allianz, Barmenia, Debeka, DEVK, DKV und SDK gearbeitet und
        dort gelernt, wie Versicherungen funktionieren, bis ins Detail.
      </p>
      <p>
        Seit fünf Jahren bin ich unabhängiger Makler und gebe dieses Wissen an Sie weiter:
        verständlich, ehrlich und mit über 300 Versicherern zur Auswahl.
      </p>
      <blockquote class="about__quote">
        <p>„Ich sage Ihnen ehrlich, ob sich ein Wechsel lohnt. Und wenn nicht, sage ich Ihnen auch das.“</p>
        <footer>Helmut Emmert</footer>
      </blockquote>
    </div>
  </div>

  <div class="wrap">
    <ul class="about__promises">
      {zusagen.map((z) => (
        <li>
          <span class="about__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={z.icon} /></svg>
          </span>
          <div>
            <h3>{z.titel}</h3>
            <p>{z.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .about__photo img {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: 80% 30%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .about__text h2 {
    margin-bottom: 1.5rem;
  }

  .about__text > p {
    color: var(--ink-soft);
  }

  .about__text > p + p {
    margin-top: 1rem;
  }

  .about__quote {
    margin-top: 2rem;
    padding-left: 1.5rem;
    border-left: 3px solid var(--green);
  }

  .about__quote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .about__quote footer {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--green);
  }

  .about__promises {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: 0;
    list-style: none;
  }

  .about__promises li {
    display: flex;
    gap: 1.25rem;
    padding: 1.75rem;
    background: var(--warm);
    border-radius: var(--radius-lg);
  }

  .about__icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--green);
    color: var(--paper);
    border-radius: var(--radius);
  }

  .about__promises h3 {
    margin-bottom: 0.4rem;
  }

  .about__promises p {
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  @media (max-width: 56rem) {
    .about__grid,
    .about__promises {
      grid-template-columns: 1fr;
    }
  }
</style>
