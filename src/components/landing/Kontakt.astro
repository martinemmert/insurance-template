---
import { Image } from 'astro:assets';
import buero from '../../assets/photos/helmut-buero.jpeg';
import { kontakt } from '../../data/kontakt';
---

<section class="section contact" id="kontakt" aria-labelledby="contact-title">
  <div class="wrap contact__grid">
    <div class="contact__info">
      <h2 id="contact-title">15 Minuten, die sich lohnen.</h2>
      <p class="contact__intro">
        Kostenlos, unverbindlich, per Telefon oder Video. Danach wissen Sie, was zu Ihnen passt.
      </p>

      <div class="contact__person">
        <Image src={buero} alt="" width={480} class="contact__avatar" />
        <p>Sie sprechen direkt mit mir. Kein Callcenter.</p>
      </div>

      <a href={kontakt.telefonLink} class="contact__phone">{kontakt.telefonAnzeige}</a>
      <dl class="contact__details">
        <div>
          <dt>E-Mail</dt>
          <dd><a href={`mailto:${kontakt.email}`}>{kontakt.email}</a></dd>
        </div>
        <div>
          <dt>Büro</dt>
          <dd>{kontakt.strasse}, {kontakt.ort}</dd>
        </div>
      </dl>
    </div>

    <form class="contact__form" id="kontakt-formular">
      <p class="contact__form-title">Lieber zurückrufen lassen?</p>

      <div class="field">
        <label for="k-name">Name</label>
        <input id="k-name" name="name" type="text" autocomplete="name" required />
      </div>

      <div class="field-row">
        <div class="field">
          <label for="k-telefon">Telefon</label>
          <input id="k-telefon" name="telefon" type="tel" autocomplete="tel" required />
        </div>
        <div class="field">
          <label for="k-email">E-Mail <span class="field__optional">(freiwillig)</span></label>
          <input id="k-email" name="email" type="email" autocomplete="email" />
        </div>
      </div>

      <div class="field">
        <label for="k-anliegen">Worum geht es?</label>
        <select id="k-anliegen" name="anliegen">
          <optgroup label="Private Krankenversicherung">
            <option value="angestellt">PKV für Angestellte</option>
            <option value="selbststaendig">PKV für Selbstständige</option>
            <option value="beamt">PKV für Beamte und Anwärter</option>
            <option value="privat">Meinen PKV-Beitrag prüfen</option>
          </optgroup>
          <optgroup label="Weitere Leistungen">
            <option value="bu">Berufsunfähigkeit</option>
            <option value="altersvorsorge">Altersvorsorge</option>
            <option value="zusatz">Zusatzversicherung (Zahn, Krankenhaus, Pflege)</option>
            <option value="anderes">Etwas anderes</option>
          </optgroup>
        </select>
      </div>

      <div class="field">
        <label for="k-nachricht">Nachricht <span class="field__optional">(freiwillig)</span></label>
        <textarea id="k-nachricht" name="nachricht" rows="3" placeholder="Zum Beispiel, wann Sie am besten erreichbar sind"></textarea>
      </div>

      <button type="submit" class="button contact__submit">Rückruf anfordern</button>
      <p class="contact__privacy">
        Ich nutze Ihre Angaben nur, um mich bei Ihnen zu melden. Mehr dazu in der <a href="#datenschutz">Datenschutzerklärung</a>.
      </p>
    </form>
  </div>
</section>

<script>
  // Carry the choice from the PKV check into the contact form
  document.querySelectorAll<HTMLAnchorElement>('[data-anliegen]').forEach((link) => {
    link.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#k-anliegen');
      if (select && link.dataset.anliegen) {
        select.value = link.dataset.anliegen;
      }
    });
  });
</script>

<style>
  .contact {
    background: var(--warm);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem 5rem;
    align-items: start;
  }

  .contact__info h2 {
    margin-bottom: 1.25rem;
  }

  .contact__intro {
    color: var(--ink-soft);
    margin-bottom: 2.5rem;
  }

  .contact__person {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .contact__person p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.4;
  }

  .contact__avatar {
    flex-shrink: 0;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: 77% 22%;
    box-shadow: var(--shadow);
  }

  .contact__phone {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 1;
    color: var(--green);
    text-decoration: none;
    white-space: nowrap;
  }

  .contact__phone:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.12em;
  }

  .contact__details {
    display: grid;
    gap: 1rem;
  }

  .contact__details dt {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .contact__details dd {
    margin: 0;
  }

  .contact__form {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    background: var(--paper);
    color: var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .contact__form :focus-visible {
    outline-color: var(--green);
  }

  .contact__form-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.1;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .field label {
    font-weight: 500;
    font-size: var(--step--1);
  }

  .field__optional {
    font-weight: 400;
    color: var(--ink-soft);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--ink-soft);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
  }

  .field textarea {
    resize: vertical;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline-offset: 0;
    border-color: var(--green);
  }

  .contact__submit {
    width: 100%;
  }

  .contact__privacy {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  @media (max-width: 56rem) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .field-row {
      grid-template-columns: 1fr;
    }

    .contact__phone {
      font-size: var(--step-4);
    }
  }
</style>
