---
import { kontakt } from '../../data/kontakt';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const zusatz = [
  { titel: 'Zahnzusatz', href: `${base}leistungen/zahnzusatz` },
  { titel: 'Chefarzt & Zweibettzimmer', href: `${base}leistungen/wahlleistungen-krankenhaus` },
  { titel: 'Brillen & Heilpraktiker', href: `${base}leistungen/brillen-heilpraktiker` },
  { titel: 'Pflegeabsicherung', href: `${base}leistungen/pflegeabsicherung` },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__extra">
      <p>
        <strong>Gesetzlich versichert und das soll so bleiben?</strong>
        Mit einer Zusatzversicherung bekommen Sie einzelne Privatleistungen dazu.
      </p>
      <ul>
        {zusatz.map((z) => (
          <li><a href={z.href}>{z.titel}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__bottom">
      <p>
        <strong>{kontakt.name}</strong>, {kontakt.rolle}<br />
        {kontakt.strasse}, {kontakt.ort}<br />
        <a href={kontakt.telefonLink}>{kontakt.telefonAnzeige}</a>, <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
      </p>
      <ul class="footer__legal">
        <li><a href="#impressum">Impressum</a></li>
        <li><a href="#datenschutz">Datenschutz</a></li>
        <li><a href="#erstinformation">Erstinformation</a></li>
      </ul>
    </div>
  </div>
</footer>

<div class="callbar">
  <a href={kontakt.telefonLink} class="button button--quiet">Anrufen</a>
  <a href="#kontakt" class="button">Erstgespräch</a>
</div>

<style>
  .footer {
    padding-block: 3.5rem 2.5rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .footer__extra {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 4rem;
    padding-bottom: 2.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .footer__extra strong {
    display: block;
    color: var(--ink);
    font-size: var(--step-0);
    margin-bottom: 0.25rem;
  }

  .footer__extra ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem 2rem;
    padding: 0;
    list-style: none;
    align-content: start;
  }

  .footer a {
    color: var(--ink);
    text-underline-offset: 0.2em;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer__bottom strong {
    color: var(--ink);
  }

  .footer__legal {
    display: flex;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .callbar {
    display: none;
  }

  @media (max-width: 48rem) {
    .footer__extra,
    .footer__extra ul {
      grid-template-columns: 1fr;
    }

    .footer {
      padding-bottom: 6.5rem;
    }

    .callbar {
      position: fixed;
      inset: auto 0 0;
      z-index: 60;
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 0.6rem;
      padding: 0.6rem 1rem calc(0.6rem + env(safe-area-inset-bottom));
      background: var(--paper);
      border-top: 1px solid var(--line);
    }
  }
</style>
