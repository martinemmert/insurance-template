---
import { bewertungen } from '../../data/kontakt';

// Google reviews, quoted verbatim
const stimmen = [
  {
    text: 'Mein Besuch bei Herr Emmert hat sich auf jeden Fall gelohnt. Dank der tollen Beratung und Hilfe spare ich aktuell um die 300 Euro.',
    autor: 'Jonas LMk',
    wann: 'vor einem Monat',
  },
  {
    text: 'Die Beratung war äußerst kompetent, umfassend und auf meine individuellen Fragen und Bedürfnisse zugeschnitten. Ich kann Herrn Emmert uneingeschränkt weiterempfehlen.',
    autor: 'Nicole Jung-Feil',
    wann: 'vor 4 Monaten',
  },
  {
    text: 'Endlich habe ich meine Versicherungen auf einem Blick. Herr Emmert geht auf meine Wünsche ein und kümmert sich super schnell um meine Anliegen.',
    autor: 'Anna Jenschur',
    wann: 'vor einem Jahr',
  },
];
---

<section class="section voices" aria-labelledby="voices-title">
  <div class="wrap">
    <div class="voices__head">
      <h2 id="voices-title">Was meine Kunden sagen</h2>
      <p>{bewertungen.sterne} von 5 Sternen bei {bewertungen.anzahl} Google-Bewertungen</p>
    </div>

    <div class="voices__grid">
      {stimmen.map((s) => (
        <figure class="voices__card">
          <span class="voices__stars" aria-label="5 von 5 Sternen">
            {[0, 1, 2, 3, 4].map(() => (
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.94 6.24 6.81.82-5.03 4.67 1.33 6.73L12 17.6l-6.05 3.36 1.33-6.73L2.25 9.56l6.81-.82z"/></svg>
            ))}
          </span>
          <blockquote>
            <p>„{s.text}“</p>
          </blockquote>
          <figcaption>
            <span class="voices__avatar" aria-hidden="true">{s.autor.charAt(0)}</span>
            <span>
              <strong>{s.autor}</strong>
              <span class="voices__when">{s.wann} auf Google</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .voices {
    background: var(--green);
    color: var(--paper);
  }

  .voices__head {
    text-align: center;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .voices__head h2 {
    margin-bottom: 0.6rem;
  }

  .voices__head p {
    margin-inline: auto;
    color: var(--green-tint);
  }

  .voices__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .voices__card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
  }

  .voices__stars {
    display: flex;
    gap: 2px;
    color: var(--sand);
  }

  .voices__card blockquote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .voices__card figcaption {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: auto;
    font-size: var(--step--1);
  }

  .voices__avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--green-light);
    color: var(--green-dark);
    font-weight: 700;
  }

  .voices__when {
    display: block;
    color: var(--green-tint);
    opacity: 0.8;
  }

  @media (max-width: 56rem) {
    .voices__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
