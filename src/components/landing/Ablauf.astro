---
import { getCollection, render } from 'astro:content';

const schritte = (await getCollection('onboarding')).sort((a, b) =>
  a.data.number.localeCompare(b.data.number),
);
---

<section class="section section--warm steps" id="ablauf" aria-labelledby="steps-title">
  <div class="wrap">
    <h2 id="steps-title" class="steps__title">So läuft die Beratung ab</h2>
    <ol class="steps__list">
      {schritte.map(async (schritt, index) => {
        const { Content } = await render(schritt);
        return (
          <li class="steps__item">
            <span class="steps__number" aria-hidden="true">{index + 1}</span>
            <h3>{schritt.data.title}</h3>
            <div class="steps__text"><Content /></div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .steps__title {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .steps__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2rem;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .steps__item {
    position: relative;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .steps__number {
    position: absolute;
    top: -1.1rem;
    left: 0;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    background: var(--green);
    color: var(--paper);
    border: 3px solid var(--warm);
    border-radius: 50%;
    font-weight: 600;
    font-size: var(--step--1);
  }

  .steps__item h3 {
    font-size: var(--step-1);
    margin: 1rem 0 0.6rem;
  }

  .steps__text {
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  @media (max-width: 64rem) {
    .steps__list {
      grid-template-columns: 1fr;
      gap: 0;
      max-width: 40rem;
    }

    .steps__item {
      display: grid;
      grid-template-columns: 3.25rem 1fr;
      padding: 0 0 2rem;
      border-top: 0;
    }

    .steps__item::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 1.1rem;
      width: 1px;
      background: var(--line);
    }

    .steps__item:last-child::before {
      display: none;
    }

    .steps__number {
      position: relative;
      top: 0;
      grid-row: 1 / span 2;
    }

    .steps__item h3 {
      margin-top: 0.2rem;
    }

    .steps__item h3,
    .steps__text {
      grid-column: 2;
    }
  }
</style>
