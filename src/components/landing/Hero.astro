---
import { Image } from 'astro:assets';
import portrait from '../../assets/photos/helmut-schloss.png';
import { kontakt, bewertungen } from '../../data/kontakt';
---

<section class="hero" id="top">
  <div class="hero__photo">
    <Image
      src={portrait}
      alt="Helmut Emmert vor Schloss Johannisburg in Aschaffenburg"
      widths={[768, 1280, 1536]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="wrap hero__grid">
    <div class="hero__panel">
      <h1>25 Jahre habe ich für Versicherer gearbeitet. Heute sitze ich auf Ihrer Seite des Tisches.</h1>
      <p class="lead">
        Ich finde für Selbstständige, Beamte und Angestellte die private Krankenversicherung,
        die auch mit 65 noch passt.
      </p>
      <div class="hero__actions">
        <a href="#kontakt" class="button">Kostenloses Erstgespräch vereinbaren</a>
        <a href={kontakt.telefonLink} class="hero__call">oder anrufen: <strong>{kontakt.telefonAnzeige}</strong></a>
      </div>
    </div>

    <div class="hero__aside">
      <p class="hero__rating">
        <span class="hero__stars" aria-hidden="true">
          {[0, 1, 2, 3, 4].map(() => (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.94 6.24 6.81.82-5.03 4.67 1.33 6.73L12 17.6l-6.05 3.36 1.33-6.73L2.25 9.56l6.81-.82z"/></svg>
          ))}
        </span>
        <span><strong>{bewertungen.sterne} von 5</strong> bei {bewertungen.anzahl} Google-Bewertungen</span>
      </p>
      <p class="hero__past">
        Früher bei Allianz, Barmenia, Debeka, DEVK, DKV und SDK. Seit fünf Jahren unabhängiger
        Makler mit Zugang zu über 300 Versicherern.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .hero__photo img {
    width: 100%;
    height: clamp(20rem, 54vh, 38rem);
    object-fit: cover;
    object-position: 35% 25%;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 2rem;
    align-items: start;
  }

  .hero__panel {
    grid-column: 6 / -1;
    grid-row: 1;
    position: relative;
    margin-top: clamp(-13rem, -18vh, -8rem);
    padding: clamp(1.75rem, 3.5vw, 3rem);
    padding-right: 0;
    background: var(--paper);
  }

  /* extend the white panel to the right edge of the viewport */
  .hero__panel::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 100%;
    width: 50vw;
    background: var(--paper);
  }

  .hero__panel h1 {
    font-size: var(--step-5);
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  .hero__panel .lead {
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .hero__call {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .hero__call strong {
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }

  .hero__call:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hero__aside {
    grid-column: 1 / 6;
    grid-row: 1;
    padding-top: 2.5rem;
    padding-right: 1rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .hero__rating {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
    color: var(--ink);
  }

  .hero__stars {
    display: flex;
    gap: 2px;
    color: var(--sand);
  }

  .hero__past {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    max-width: 22rem;
  }

  @media (max-width: 56rem) {
    .hero__photo img {
      height: clamp(18rem, 52vh, 28rem);
      object-position: 30% 20%;
    }

    .hero__panel,
    .hero__aside {
      grid-column: 1 / -1;
    }

    .hero__panel {
      margin-top: 0;
      padding: 2rem 0 0;
    }

    .hero__panel::after {
      display: none;
    }

    .hero__aside {
      grid-row: 2;
      padding-top: 2.5rem;
    }
  }
</style>
