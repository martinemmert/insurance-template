---
import { Image } from 'astro:assets';
import portrait from '../../assets/photos/helmut-schloss-tweed.png';
import { kontakt, bewertungen } from '../../data/kontakt';
---

<section class="hero" id="top">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <p class="hero__hello">Guten Tag, ich bin Helmut Emmert.</p>
      <h1>25 Jahre habe ich für Versicherer gearbeitet. Jetzt arbeite ich für Sie.</h1>
      <p class="lead">
        Ich finde Ihre private Krankenversicherung: passend für heute, bezahlbar mit 65.
        Unabhängig, aus Aschaffenburg, persönlich betreut.
      </p>
      <div class="hero__actions">
        <a href="#kontakt" class="button">Kostenloses Erstgespräch</a>
        <a href={kontakt.telefonLink} class="hero__call">oder anrufen: <strong>{kontakt.telefonAnzeige}</strong></a>
      </div>
      <p class="hero__past">
        Früher bei Allianz, Barmenia, Debeka, DEVK, DKV und SDK. Heute unabhängig, mit über 300 Versicherern zur Auswahl.
      </p>
    </div>

    <figure class="hero__photo">
      <Image
        src={portrait}
        alt="Helmut Emmert vor Schloss Johannisburg in Aschaffenburg"
        widths={[640, 960, 1280]}
        sizes="(max-width: 56rem) 100vw, 45vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="hero__rating">
        <span class="hero__stars" aria-hidden="true">
          {[0, 1, 2, 3, 4].map(() => (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.94 6.24 6.81.82-5.03 4.67 1.33 6.73L12 17.6l-6.05 3.36 1.33-6.73L2.25 9.56l6.81-.82z"/></svg>
          ))}
        </span>
        <span><strong>{bewertungen.sterne} von 5</strong> bei {bewertungen.anzahl} Google-Bewertungen</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem);
    background: linear-gradient(135deg, var(--warm) 0%, var(--warm-deep) 100%);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero__hello {
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--green);
  }

  .hero h1 {
    font-size: var(--step-5);
    margin-bottom: 1.5rem;
  }

  .hero .lead {
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .hero__call {
    text-decoration: none;
    color: var(--ink-soft);
  }

  .hero__call strong {
    color: var(--ink);
    font-weight: 700;
    white-space: nowrap;
  }

  .hero__call:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hero__past {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .hero__photo {
    position: relative;
  }

  .hero__photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 74% 30%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .hero__rating {
    position: absolute;
    bottom: -1.75rem;
    left: -1.75rem;
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 1.4rem;
    background: var(--paper);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    font-size: var(--step--1);
  }

  .hero__stars {
    display: flex;
    gap: 2px;
    color: var(--sand);
  }

  @media (max-width: 56rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__photo {
      order: -1;
      margin-bottom: 1.5rem;
    }

    .hero__photo img {
      aspect-ratio: 4 / 3;
      object-position: 78% 25%;
    }

    .hero__rating {
      left: 1rem;
      bottom: -1.5rem;
    }
  }
</style>
