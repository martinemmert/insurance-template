---
import PageSection from "./PageSection.astro";
import ArticleCard from './elements/ArticleCard.astro';
import Grid from './Grid.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<!-- Blog/Articles -->
<PageSection variant="white" label="Wissen" title="Aktuelle Ratgeber & Tipps">
    <Fragment slot="header-subtitle">Bleiben Sie informiert mit meinen neuesten Artikeln zu Versicherungen und Vorsorge.</Fragment>
    <Grid columns={3}>
      <ArticleCard
        title="Diese Versicherungen können Sie von der Steuer absetzen"
        description="Viele wissen nicht, dass bestimmte Versicherungsbeiträge steuerlich absetzbar sind. Ein Überblick."
        image="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=600&h=400&fit=crop"
        imageAlt="Steuererklärung"
        category="Steuern"
        meta="15. Januar 2024 &bull; 5 Min. Lesezeit"
      />
      <ArticleCard
        title="BU-Versicherung: Die 5 häufigsten Fehler beim Abschluss"
        description="Worauf Sie achten müssen, damit die BU im Ernstfall auch wirklich zahlt."
        image="https://images.unsplash.com/photo-1559526324-4b87b5e36e44?w=600&h=400&fit=crop"
        imageAlt="Berufsunfähigkeit"
        category="Berufsunfähigkeit"
        meta="8. Januar 2024 &bull; 7 Min. Lesezeit"
      />
      <ArticleCard
        title="Rentenlücke berechnen: So viel fehlt Ihnen wirklich"
        description="Eine einfache Methode, um herauszufinden, wie viel Sie für die Rente zurücklegen sollten."
        image="https://images.unsplash.com/photo-1532629345422-7515f3d16bb6?w=600&h=400&fit=crop"
        imageAlt="Altersvorsorge"
        category="Altersvorsorge"
        meta="2. Januar 2024 &bull; 6 Min. Lesezeit"
      />
    </Grid>
</PageSection>
