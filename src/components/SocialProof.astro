---
import PageSection from "./PageSection.astro";
import Stars from './elements/Stars.astro';
// custom styles: padding: 2rem 4rem;
---
<!-- Social Proof Bar -->
<PageSection variant="gray">
    <div class="social-proof">
      <div class="social-proof__item">
        <Stars count={5} />
        <div class="social-proof__text">4.9/5 bei Google (47 Bewertungen)</div>
      </div>
      <div class="social-proof__item">
        <Stars count={5} />
        <div class="social-proof__text">5.0/5 bei ProvenExpert</div>
      </div>
      <div class="social-proof__item">
        <Stars count={5} />
        <div class="social-proof__text">98% Weiterempfehlung</div>
      </div>
    </div>
</PageSection>

<style>
  .social-proof {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4rem;
    flex-wrap: wrap;
  }
  .social-proof__item {
    display: flex;
    flex-direction: column;
  }
  .social-proof__text {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .social-proof { gap: 2rem; }
  }
</style>
