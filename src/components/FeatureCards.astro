---
import PageSection from "./PageSection.astro";
import FeatureCard from './elements/FeatureCard.astro';
import Grid from './Grid.astro';
---

<!-- Feature Cards -->
<PageSection variant="gray" label="Schwerpunkte" title="Meine Kernkompetenzen">
    <Grid columns={3}>
      <FeatureCard title="Privatkundenberatung" description="Individuelle Lösungen für Familien, Singles und Paare – von der Grundabsicherung bis zur Vermögensplanung.">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
      </FeatureCard>
      <FeatureCard title="Gewerbeversicherung" description="Maßgeschneiderte Absicherung für Selbstständige, Freiberufler und kleine Unternehmen.">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
      </FeatureCard>
      <FeatureCard title="Schadensmanagement" description="Professionelle Unterstützung bei der Schadensmeldung und Durchsetzung Ihrer Ansprüche.">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      </FeatureCard>
    </Grid>
</PageSection>
