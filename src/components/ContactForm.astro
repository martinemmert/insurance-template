---
import Grid from './Grid.astro';
import PageSection from "./PageSection.astro";
import Heading from './elements/Heading.astro';
import Text from './elements/Text.astro';
import Button from './elements/Button.astro';
import FormField from './elements/FormField.astro';
// custom attributes: id="kontakt"
---
<!-- Contact -->
<PageSection>
    <Grid columns={2} gap="4rem" class="contact">
      <div class="contact__info">
        <Heading as="h3" size="2xl" serif class="mb-4">Lassen Sie uns sprechen</Heading>
        <Text muted class="mb-8">Vereinbaren Sie jetzt Ihr kostenloses Erstgespräch. Ich freue mich darauf, Sie kennenzulernen.</Text>
        <div class="contact__item">
          <div class="contact__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div>
            <div class="contact__label">Telefon</div>
            <div class="contact__value">+49 123 456 789</div>
          </div>
        </div>
        <div class="contact__item">
          <div class="contact__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <div>
            <div class="contact__label">E-Mail</div>
            <div class="contact__value">info@emmert-versicherungen.de</div>
          </div>
        </div>
        <div class="contact__item">
          <div class="contact__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <div>
            <div class="contact__label">Adresse</div>
            <div class="contact__value">Musterstraße 123, 63739 Aschaffenburg</div>
          </div>
        </div>
      </div>
      <form class="contact__form">
        <div class="form-row">
          <FormField label="Name" id="name" name="name" placeholder="Ihr Name" required />
          <FormField label="Telefon" type="tel" id="phone" name="phone" placeholder="Ihre Telefonnummer" />
        </div>
        <FormField label="E-Mail" type="email" id="email" name="email" placeholder="Ihre E-Mail-Adresse" required />
        <FormField label="Nachricht" type="textarea" id="message" name="message" placeholder="Wie kann ich Ihnen helfen?" />
        <Button type="submit" style="width: 100%;">Nachricht senden</Button>
      </form>
    </Grid>
</PageSection>

<style>
  .contact__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .contact__icon {
    width: 3rem;
    height: 3rem;
    background: var(--color-bg-light);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }
  .contact__label {
    font-size: var(--text-sm);
    color: var(--color-text-faint);
  }
  .contact__value {
    font-weight: var(--font-semibold);
  }
  .contact__form {
    background: var(--color-bg-warm);
    padding: 2.5rem;
    border-radius: var(--radius-lg);
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 1024px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>
