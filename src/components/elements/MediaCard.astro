---
import Card from './Card.astro';

const { class: className, ...rest } = Astro.props;
---

<Card class:list={['media-card', className]} {...rest}>
  <div class="media-card__media">
    <slot name="media" />
  </div>
  <div class="media-card__content">
    <slot name="category" />
    <slot name="heading" />
    <slot />
    <slot name="meta" />
    <slot name="action" />
  </div>
</Card>

<style>
  .media-card {
    overflow: hidden;
  }
  .media-card__media :global(img),
  .media-card__media :global(video) {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  .media-card__content {
    padding: 1.5rem;
  }
</style>
