---
const { count = 5, size = 'md', class: className, ...rest } = Astro.props;
const sizeClass = `stars--${size}`;
const stars = '★'.repeat(count);
---

<div class:list={['stars', sizeClass, className]} {...rest}>{stars}</div>

<style>
  .stars {
    color: var(--color-star);
  }
  .stars--sm {
    font-size: var(--text-base);
  }
  .stars--md {
    font-size: var(--text-lg);
  }
  .stars--lg {
    font-size: 1.5rem;
  }
</style>
