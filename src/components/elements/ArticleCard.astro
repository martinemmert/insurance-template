---
import MediaCard from './MediaCard.astro';
import Heading from './Heading.astro';
import Text from './Text.astro';
import Badge from './Badge.astro';

const { title, description, image, imageAlt, category, meta, class: className, ...rest } = Astro.props;
---

<MediaCard as="article" shadow="md" hover="lift" class={className} {...rest}>
  <img slot="media" src={image} alt={imageAlt}>
  <Badge slot="category" class="mb-3">{category}</Badge>
  <Heading slot="heading" as="h3" size="lg" class="mb-2">{title}</Heading>
  <Text size="sm" muted class="mb-4">{description}</Text>
  <Text slot="meta" as="span" size="xs" faint>{meta}</Text>
</MediaCard>
