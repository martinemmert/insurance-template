---
import PageSection from "./PageSection.astro";
import BenefitCard from './elements/BenefitCard.astro';
import Grid from './Grid.astro';
---

<PageSection variant="white" label="Warum ich" title="Was Sie bei mir anders erleben">
    <Grid columns={2}>
      <BenefitCard title="Kein Tarifdschungel" description="Ich vergleiche für Sie und übersetze das Kleingedruckte in klare Empfehlungen. Sie entscheiden  - ohne Fragezeichen.">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </BenefitCard>
      <BenefitCard title="Ihr Tarif, nicht meiner" description="Über 300 Produktpartner, kein Hausversicherer. Ich bin keinem Anbieter verpflichtet und empfehle nur, was zu Ihrer Situation passt.">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
      </BenefitCard>
      <BenefitCard title="Persönlich erreichbar" description="Videocall, Telefon oder Büro in Aschaffenburg  - Sie wählen den Weg. Und wenn es drauf ankommt, bin ich direkt erreichbar. Nicht ein Callcenter.">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
      </BenefitCard>
      <BenefitCard title="Auch nach Vertragsschluss" description="Ich prüfe Ihren Schutz jährlich, begleite Schadensfälle und bin bei Lebensereignissen wie Nachwuchs, Jobwechsel oder Hausbau Ihr erster Ansprechpartner.">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </BenefitCard>
    </Grid>
</PageSection>
