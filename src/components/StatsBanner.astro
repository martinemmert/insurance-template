---
import PageSection from "./PageSection.astro";
import Stat from './elements/Stat.astro';
import Grid from './Grid.astro';
// custom styles: padding: 4rem;
---
<PageSection variant="dark">
    <Grid columns={4} mobileColumns={2} class="stats-banner">
      <Stat value="25+" label="Jahre Berufserfahrung" size="lg" class="stats-banner__item" />
      <Stat value="1.500+" label="Zufriedene Kunden" size="lg" class="stats-banner__item" />
      <Stat value="100+" label="Versicherungspartner" size="lg" class="stats-banner__item" />
      <Stat value="98%" label="Weiterempfehlungsrate" size="lg" class="stats-banner__item" />
    </Grid>
</PageSection>

<style>
  .stats-banner {
    text-align: center;
  }
  .stats-banner__item {
    padding: 2rem 1rem;
  }

  @media (max-width: 1024px) {
    .stats-banner { --grid-gap: 1rem; }
  }
</style>
