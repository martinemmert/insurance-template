---
---

<section class="section section--dark" style="padding: 4rem;">
  <div class="section__container">
    <div class="stats-banner">
      <div class="stats-banner__item">
        <div class="stats-banner__number">25+</div>
        <div class="stats-banner__label">Jahre Berufserfahrung</div>
      </div>
      <div class="stats-banner__item">
        <div class="stats-banner__number">1.500+</div>
        <div class="stats-banner__label">Zufriedene Kunden</div>
      </div>
      <div class="stats-banner__item">
        <div class="stats-banner__number">100+</div>
        <div class="stats-banner__label">Versicherungspartner</div>
      </div>
      <div class="stats-banner__item">
        <div class="stats-banner__number">98%</div>
        <div class="stats-banner__label">Weiterempfehlungsrate</div>
      </div>
    </div>
  </div>
</section>

<style>
  .stats-banner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    text-align: center;
  }
  .stats-banner__item {
    padding: 2rem 1rem;
  }
  .stats-banner__number {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }
  .stats-banner__label {
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .stats-banner { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  }
</style>
