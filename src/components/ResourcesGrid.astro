---
import PageSection from "./PageSection.astro";
import ResourceCard from './elements/ResourceCard.astro';
import Grid from './Grid.astro';
---

<PageSection variant="gray" label="Kostenlose Ressourcen" title="Nützliche Ratgeber zum Download">
    <Fragment slot="header-subtitle">Informieren Sie sich vorab – alle Guides sind kostenlos und unverbindlich.</Fragment>
    <Grid columns={3}>
      <ResourceCard href="#" title="BU-Versicherung verstehen" description="Alles, was Sie über die Berufsunfähigkeitsversicherung wissen müssen." meta="PDF &bull; 12 Seiten">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
      </ResourceCard>
      <ResourceCard href="#" title="Checkliste Erstgespräch" description="Diese Unterlagen sollten Sie zum ersten Beratungstermin mitbringen." meta="PDF &bull; 2 Seiten">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
      </ResourceCard>
      <ResourceCard href="#" title="Altersvorsorge-Rechner" description="Berechnen Sie Ihre Rentenlücke und den Sparbedarf." meta="Excel &bull; Interaktiv">
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
      </ResourceCard>
    </Grid>
</PageSection>
