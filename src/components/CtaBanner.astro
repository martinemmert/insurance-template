---
import PageSection from "./PageSection.astro";
import Heading from './elements/Heading.astro';
import Button from './elements/Button.astro';
// custom styles: padding-top: 0;
---
<!-- CTA Banner -->
<PageSection>
    <div class="cta-banner">
      <div class="cta-banner__content">
        <Heading as="h3" size="2xl" serif class="mb-2">Unsicher, welche Versicherung Sie brauchen?</Heading>
        <p>In einem kostenlosen Erstgespräch analysiere ich Ihre Situation und zeige Ihnen, wo Sie gut abgesichert sind – und wo nicht.</p>
      </div>
      <Button href="#kontakt" variant="inverted">Jetzt Termin vereinbaren</Button>
    </div>
</PageSection>

<style>
  .cta-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, #2d6b45 100%);
    padding: 3rem;
    border-radius: 1.5rem;
  }
  .cta-banner__content :global(.heading) {
    color: var(--color-white);
  }
  .cta-banner__content p {
    color: rgba(255,255,255,0.8);
    font-size: var(--text-md);
  }
  .cta-banner :global(.btn) {
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .cta-banner { flex-direction: column; text-align: center; }
  }
</style>
