---
import Grid from './Grid.astro';
import PageSection from "./PageSection.astro";
import Heading from './elements/Heading.astro';
import Card from './elements/Card.astro';
---

<!-- Problem / Solution -->
<PageSection variant="white" label="Die Herausforderung" title="Versicherungen sind kompliziert. Das muss nicht sein.">
    <Grid columns={2} gap="3rem" class="problem-solution">
      <Card class="problem-card p-10">
        <div class="problem-card__label">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
          Das Problem
        </div>
        <Heading as="h3" size="xl" serif class="mb-4">Ohne unabhängige Beratung</Heading>
        <ul class="problem-card__list">
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            Stundenlange Recherche und Vergleiche im Internet
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            Vertreter, die nur ihre eigenen Produkte verkaufen
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            Unübersichtliche Tarife und versteckte Klauseln
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            Im Schadensfall allein gegen die Versicherung
          </li>
        </ul>
      </Card>
      <Card class="solution-card p-10">
        <div class="solution-card__label">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          Die Lösung
        </div>
        <Heading as="h3" size="xl" serif class="mb-4">Mit Helmut Emmert</Heading>
        <ul class="solution-card__list">
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Ein Ansprechpartner, der den Markt für Sie durchsucht
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Unabhängige Empfehlungen ohne Verkaufsdruck
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Verständliche Erklärungen in klarer Sprache
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Ihr Anwalt im Schadensfall – auf Ihrer Seite
          </li>
        </ul>
      </Card>
    </Grid>
</PageSection>

<style>
  .problem-card {
    background: #fef2f2;
    border: 1px solid #fecaca;
  }
  .solution-card {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
  }
  .problem-card__label, .solution-card__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }
  .problem-card__label {
    color: #dc2626;
  }
  .solution-card__label {
    color: #059669;
  }
  .problem-card__list, .solution-card__list {
    list-style: none;
  }
  .problem-card__list li, .solution-card__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.9375rem;
  }
  .problem-card__list li svg {
    color: #dc2626;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  .solution-card__list li svg {
    color: #059669;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
</style>
