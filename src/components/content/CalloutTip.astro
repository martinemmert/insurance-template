  .callout__icon {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.125rem;
  }
  .callout__content {
    flex: 1;
  }
  .callout__title {
    font-weight: var(--font-bold);
    margin-bottom: 0.25rem;
  }
  .callout__text {
    font-size: 0.9375rem;
    line-height: var(--leading-normal);
  }
  .callout--tip {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
  }
  .callout--tip .callout__icon { color: #059669; }
  .callout--tip .callout__title { color: #065f46; }
  .callout--tip .callout__text { color: #065f46; }
</style>
