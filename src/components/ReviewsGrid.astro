---
import PageSection from "./PageSection.astro";
import ReviewCard from './elements/ReviewCard.astro';
import Grid from './Grid.astro';
---

<PageSection variant="dark" label="Kundenstimmen" title="Was meine Kunden sagen">
    <Fragment slot="header-subtitle">5,0 von 5 Sternen bei 30 Google-Bewertungen</Fragment>
    <Grid columns={3}>
      <ReviewCard class="p-8" author="Nicole Jung-Feil" date="vor 4 Monaten">Die Beratung war äußerst kompetent, umfassend und auf meine individuellen Fragen und Bedürfnisse zugeschnitten. Ich kann Herrn Emmert uneingeschränkt weiterempfehlen.</ReviewCard>
      <ReviewCard class="p-8" author="Jonas LMk" date="vor einem Monat">Mein Besuch bei Herr Emmert hat sich auf jeden Fall gelohnt. Dank der tollen Beratung und Hilfe spare ich aktuell um die 300 Euro.</ReviewCard>
      <ReviewCard class="p-8" author="Anna Jenschur" date="vor einem Jahr">Endlich habe ich meine Versicherungen auf einem Blick. Herr Emmert geht auf meine Wünsche ein und kümmert sich super schnell um meine Anliegen.</ReviewCard>
    </Grid>
</PageSection>
