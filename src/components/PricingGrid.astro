---
import PageSection from "./PageSection.astro";
import Heading from './elements/Heading.astro';
import Text from './elements/Text.astro';
import Button from './elements/Button.astro';
import Card from './elements/Card.astro';
import IconList from './elements/IconList.astro';
import Grid from './Grid.astro';
---

<!-- Service Packages -->
<PageSection variant="gray" label="Beratungsangebote" title="Wählen Sie Ihr Paket">
    <Fragment slot="header-subtitle">Für jeden Bedarf das passende Angebot – von der Einzelfrage bis zur Komplettbetreuung.</Fragment>
    <Grid columns={3}>
      <Card shadow="md" hover="lift" class="pricing-card p-10 text-center">
        <div class="pricing-card__label">Einstieg</div>
        <Heading as="h3" size="xl" serif class="mb-4">Versicherungs-Check</Heading>
        <Text size="sm" muted class="pricing-card__desc mb-6">Schnelle Analyse Ihrer bestehenden Verträge mit konkreten Empfehlungen.</Text>
        <IconList class="pricing-card__features" items={[
          'Prüfung aller bestehenden Policen',
          'Identifikation von Versicherungslücken',
          'Schriftlicher Bericht mit Empfehlungen',
        ]} />
        <Button href="#kontakt" variant="secondary">Anfragen</Button>
      </Card>
      <Card shadow="md" hover="lift" class="pricing-card pricing-card--featured p-10 text-center">
        <div class="pricing-card__label">Empfohlen</div>
        <Heading as="h3" size="xl" serif class="mb-4">Rundum-Beratung</Heading>
        <Text size="sm" muted class="pricing-card__desc mb-6">Komplette Analyse und Neuaufstellung Ihres Versicherungsschutzes.</Text>
        <IconList class="pricing-card__features" items={[
          'Alles aus dem Versicherungs-Check',
          'Detaillierter Marktvergleich',
          'Vertragsverhandlung & Abschluss',
          'Jährliche Überprüfung',
        ]} />
        <Button href="#kontakt" variant="inverted">Termin vereinbaren</Button>
      </Card>
      <Card shadow="md" hover="lift" class="pricing-card p-10 text-center">
        <div class="pricing-card__label">Premium</div>
        <Heading as="h3" size="xl" serif class="mb-4">VIP-Betreuung</Heading>
        <Text size="sm" muted class="pricing-card__desc mb-6">Exklusive Betreuung für anspruchsvolle Kunden mit komplexen Anforderungen.</Text>
        <IconList class="pricing-card__features" items={[
          'Alles aus der Rundum-Beratung',
          'Prioritäre Erreichbarkeit',
          'Hausbesuche nach Vereinbarung',
          'Familien-Mitbetreuung',
        ]} />
        <Button href="#kontakt" variant="secondary">Anfragen</Button>
      </Card>
    </Grid>
</PageSection>

<style>
  .pricing-card--featured {
    background: var(--color-primary);
    color: var(--color-white);
    transform: scale(1.05);
  }
  .pricing-card--featured:hover {
    transform: scale(1.05) translateY(-4px);
  }
  .pricing-card__label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }
  .pricing-card--featured .pricing-card__label {
    color: var(--color-primary-light);
  }
  .pricing-card--featured :global(.text) {
    color: rgba(255,255,255,0.7);
  }
  .pricing-card__features {
    text-align: left;
    margin-bottom: 2rem;
  }
  .pricing-card__features :global(li) {
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .pricing-card--featured .pricing-card__features :global(li) {
    border-color: rgba(255,255,255,0.1);
  }
  .pricing-card--featured .pricing-card__features :global(svg) {
    color: var(--color-primary-light);
  }
  .pricing-card :global(.btn) {
    display: block;
    padding: 1rem;
    text-align: center;
  }

  @media (max-width: 1024px) {
    .pricing-card--featured { transform: none; }
    .pricing-card--featured:hover { transform: translateY(-4px); }
  }
</style>
