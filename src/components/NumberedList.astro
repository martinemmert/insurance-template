---
import {getCollection, render} from 'astro:content';
import PageSection from "./PageSection.astro";
import NumberedItem from "./elements/NumberedItem.astro";

const onboarding = (await getCollection('onboarding')).sort((a, b) =>
    a.data.number.localeCompare(b.data.number)
);
---

<PageSection label="So funktioniert's" title="Ihr Weg zur besseren Absicherung" contentWidth="narrow">
    {onboarding.map(async (entry) => {
        const {Content} = await render(entry);
        return (
                <NumberedItem number={entry.data.number} title={entry.data.title}>
                    <Content/>
                </NumberedItem>
        );
    })}
</PageSection>