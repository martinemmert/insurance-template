---
import { getCollection, render } from 'astro:content';
import PageSection from "./PageSection.astro";
import Heading from './elements/Heading.astro';
import Text from './elements/Text.astro';

const onboarding = (await getCollection('onboarding')).sort((a, b) =>
    a.data.number.localeCompare(b.data.number)
);
---

<PageSection variant="gray" label="So funktioniert's" title="In fünf Schritten zur besseren Absicherung" contentWidth="narrow">
    <div class="steps">
      {onboarding.map(async (entry) => {
        const { Content } = await render(entry);
        return (
          <div class="step">
            <div class="step__marker">
              <div class="step__number">{entry.data.number}</div>
            </div>
            <div class="step__content">
              <Heading as="h3" size="lg" class="mb-2">{entry.data.title}</Heading>
              <Text size="sm" muted><Content /></Text>
            </div>
          </div>
        );
      })}
    </div>
</PageSection>

<style>
  .steps {
    display: flex;
    flex-direction: column;
  }
  .step {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 2rem;
  }
  .step__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .step__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }
  .step__marker::after {
    content: '';
    width: 2px;
    flex: 1;
    background: var(--color-border);
  }
  .step:last-child .step__marker::after {
    background: transparent;
  }
  .step__content {
    padding-bottom: 2rem;
  }
  .step:last-child .step__content {
    padding-bottom: 0;
  }
</style>
