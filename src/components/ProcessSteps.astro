---
import PageSection from "./PageSection.astro";
import Heading from './elements/Heading.astro';
import Text from './elements/Text.astro';
import Grid from './Grid.astro';
// custom attributes: id="ablauf"
---
<!-- Process -->
<PageSection variant="gray" label="So funktioniert's" title="Ihr Weg zur besseren Absicherung">
    <Fragment slot="header-subtitle">In fünf einfachen Schritten zu Ihrem optimalen Versicherungsschutz.</Fragment>
    <Grid columns={5} class="steps">
      <div class="step">
        <div class="step__number">1</div>
        <Heading as="h3" size="lg" class="mb-2">Erstgespräch</Heading>
        <Text size="sm" muted class="step__text">Wir lernen uns kennen und ich höre Ihnen zu.</Text>
      </div>
      <div class="step">
        <div class="step__number">2</div>
        <Heading as="h3" size="lg" class="mb-2">Bedarfsanalyse</Heading>
        <Text size="sm" muted class="step__text">Ich analysiere Ihren aktuellen Schutz und identifiziere Lücken.</Text>
      </div>
      <div class="step">
        <div class="step__number">3</div>
        <Heading as="h3" size="lg" class="mb-2">Angebotsvergleich</Heading>
        <Text size="sm" muted class="step__text">Sie erhalten eine transparente Gegenüberstellung der besten Angebote.</Text>
      </div>
      <div class="step">
        <div class="step__number">4</div>
        <Heading as="h3" size="lg" class="mb-2">Vertragsabschluss</Heading>
        <Text size="sm" muted class="step__text">Ich kümmere mich um den gesamten Papierkram.</Text>
      </div>
      <div class="step">
        <div class="step__number">5</div>
        <Heading as="h3" size="lg" class="mb-2">Betreuung</Heading>
        <Text size="sm" muted class="step__text">Ich begleite Sie langfristig und stehe im Schadensfall bereit.</Text>
      </div>
    </Grid>
</PageSection>

<style>
  .step {
    text-align: center;
    position: relative;
  }
  .step::after {
    content: '';
    position: absolute;
    top: 2rem;
    right: -1rem;
    width: calc(100% - 4rem);
    height: 2px;
    background: var(--color-border);
  }
  .step:last-child::after { display: none; }
  .step__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    border-radius: var(--radius-full);
    margin-bottom: 1.5rem;
  }
  @media (max-width: 1024px) {
    .step::after { display: none; }
  }
</style>
