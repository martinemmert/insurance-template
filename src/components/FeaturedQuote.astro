---
import PageSection from "./PageSection.astro";
---

<!-- Featured Quote -->
<PageSection variant="gray">
    <div class="quote-block">
      <div class="quote-block__icon">"</div>
      <p class="quote-block__text">Herr Emmert hat mir nicht einfach eine Versicherung verkauft – er hat sich die Zeit genommen, meine gesamte Lebenssituation zu verstehen. Das Ergebnis: Ein Schutz, der wirklich zu mir passt, ohne überteuerte Extras.</p>
      <div class="quote-block__author">
        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop" alt="Dr. Martin Weber" class="quote-block__avatar">
        <div>
          <div class="quote-block__name">Dr. Martin Weber</div>
          <div class="quote-block__role">Facharzt für Orthopädie, Aschaffenburg</div>
        </div>
      </div>
    </div>
</PageSection>

<style>
  .quote-block {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }
  .quote-block__icon {
    font-size: var(--text-5xl);
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: 1.5rem;
    opacity: 0.3;
  }
  .quote-block__text {
    font-family: var(--font-serif);
    font-size: var(--text-quote);
    font-weight: var(--font-medium);
    font-style: italic;
    line-height: var(--leading-snug);
    color: var(--color-text);
    margin-bottom: 2rem;
  }
  .quote-block__author {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .quote-block__avatar {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-full);
    object-fit: cover;
  }
  .quote-block__name {
    font-weight: var(--font-bold);
    font-size: var(--text-base);
  }
  .quote-block__role {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
