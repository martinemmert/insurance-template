---
import '../styles/base.css';
import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero.astro";
import SocialProof from "../components/SocialProof.astro";
import TrustBadges from "../components/TrustBadges.astro";
import Marquee from "../components/Marquee.astro";
import ProblemSolution from "../components/ProblemSolution.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import CtaBanner from "../components/CtaBanner.astro";
import FeaturedQuote from "../components/FeaturedQuote.astro";
import VideoSection from "../components/VideoSection.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import OffsetCards from "../components/OffsetCards.astro";
import IconFeatures from "../components/IconFeatures.astro";
import TabbedContent from "../components/TabbedContent.astro";
import BenefitsGrid from "../components/BenefitsGrid.astro";
import About from "../components/About.astro";
import TeamGrid from "../components/TeamGrid.astro";
import ChecklistSection from "../components/ChecklistSection.astro";
import Timeline from "../components/Timeline.astro";
import AwardsGrid from "../components/AwardsGrid.astro";
import StatsBanner from "../components/StatsBanner.astro";
import NumberedList from "../components/NumberedList.astro";
import LogoCloud from "../components/LogoCloud.astro";
import TestimonialLarge from "../components/TestimonialLarge.astro";
import ReviewsGrid from "../components/ReviewsGrid.astro";
import ImageGallery from "../components/ImageGallery.astro";
import FeatureCards from "../components/FeatureCards.astro";
import SplitContent from "../components/SplitContent.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import TwoColumnText from "../components/TwoColumnText.astro";
import ResourcesGrid from "../components/ResourcesGrid.astro";
import FaqSection from "../components/FaqSection.astro";
import ContactCards from "../components/ContactCards.astro";
import PricingGrid from "../components/PricingGrid.astro";
import ContactForm from "../components/ContactForm.astro";
import ArticlesGrid from "../components/ArticlesGrid.astro";
import Newsletter from "../components/Newsletter.astro";
import Footer from "../components/Footer.astro";
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <title>Helmut Emmert - Ihr Versicherungsmakler in Aschaffenburg</title>
    <meta name="description" content="Unabhängige Versicherungsberatung für Lebensversicherung, Berufsunfähigkeit, Krankenversicherung und Altersvorsorge. Persönlich. Transparent. Fair.">
  </head>
  <body>
    <Navigation />
    <Hero />
    <SocialProof />
    <TrustBadges />
    <Marquee />
    <ProblemSolution />
    <ServicesGrid />
    <CtaBanner />
    <FeaturedQuote />
    <VideoSection />
    <ProcessSteps />
    <OffsetCards />
    <IconFeatures />
    <TabbedContent />
    <BenefitsGrid />
    <About />
    <TeamGrid />
    <ChecklistSection />
    <Timeline />
    <AwardsGrid />
    <StatsBanner />
    <NumberedList />
    <LogoCloud />
    <TestimonialLarge />
    <ReviewsGrid />
    <ImageGallery />
    <FeatureCards />
    <SplitContent />
    <ComparisonTable />
    <TwoColumnText />
    <ResourcesGrid />
    <FaqSection />
    <ContactCards />
    <PricingGrid />
    <ContactForm />
    <ArticlesGrid />
    <Newsletter />
    <Footer />
  </body>
</html>
