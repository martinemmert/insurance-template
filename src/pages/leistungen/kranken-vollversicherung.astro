---
import Leistungsseite from '../../layouts/Leistungsseite.astro';
import PkvCheck from '../../components/landing/PkvCheck.astro';
import Fragen from '../../components/landing/Fragen.astro';
---

<Leistungsseite
  title="Private Krankenversicherung in Aschaffenburg | Helmut Emmert"
  description="Private Kranken-Vollversicherung: freie Arztwahl, starke Leistungen und ein Tarif, der langfristig zu Ihnen passt. Unabhängige Beratung in Aschaffenburg."
  name="Private Krankenversicherung"
  headline="Private Krankenversicherung: Versorgung, die zu Ihrem Leben passt."
  lead="Freie Arztwahl, schnelle Termine und ein Tarif, der nicht nur im ersten Jahr passt, sondern auch in zwanzig Jahren noch. Ich begleite Sie von der ersten Frage bis zum passenden Tarif und darüber hinaus."
  anliegen="angestellt"
>
  <section class="section">
    <div class="wrap leistung-split">
      <div class="leistung-text">
        <h2>Was die PKV Ihnen bietet</h2>
        <p>
          Als Privatpatient haben Sie Zugang zu Spezialisten, bekommen oft schneller einen Termin und
          eine Versorgung, die sich an Ihren Bedürfnissen orientiert.
        </p>
        <p>
          Ich vergleiche für Sie Tarife von über 300 Versicherern und finde die Lösung, die zu Ihrer
          Lebenssituation passt: vom Einsteigertarif mit Selbstbeteiligung bis zum umfassenden Premiumschutz.
        </p>
      </div>

      <div>
        <h2>Worauf ich für Sie achte</h2>
        <ul class="leistung-checks">
          <li>
            <strong>Stabile Beiträge im Alter</strong>
            <span>Damit Ihr Tarif auch in 20 Jahren noch gut zu stemmen ist, planen wir Beitragsentlastung von Anfang an mit.</span>
          </li>
          <li>
            <strong>Leistungen, die Sie wirklich brauchen</strong>
            <span>Ambulant, stationär, Zähne: Wir stellen Ihren Schutz so zusammen, dass er zu Ihrem Leben passt.</span>
          </li>
          <li>
            <strong>Sorgfältige Gesundheitsfragen</strong>
            <span>Ich begleite Sie durch den Antrag, damit alle Angaben vollständig sind und Ihr Schutz sicher greift.</span>
          </li>
          <li>
            <strong>Betreuung nach dem Abschluss</strong>
            <span>Jährlicher Check, Hilfe bei Erstattungen und Tarifwechsel, wenn sich etwas ändert.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <PkvCheck />

  <Fragen />
</Leistungsseite>
