---
import Leistungsseite from '../../layouts/Leistungsseite.astro';
import PkvCheck from '../../components/landing/PkvCheck.astro';
import Fragen from '../../components/landing/Fragen.astro';
---

<Leistungsseite
  title="Private Krankenversicherung in Aschaffenburg | Helmut Emmert"
  description="Private Kranken-Vollversicherung: freie Arztwahl, starke Leistungen und ein Tarif, der langfristig zu Ihnen passt. Unabhängige Beratung in Aschaffenburg."
  name="Private Krankenversicherung"
  headline="Eine Krankenversicherung, die mit Ihrem Leben mitwächst."
  lead="Freie Arztwahl, schnelle Termine und ein Beitrag, der auch in zwanzig Jahren gut zu stemmen ist. Finden Sie heraus, ob die PKV zu Ihnen passt."
  situationen={[
    'Sie sind selbstständig, verbeamtet oder verdienen gut als Angestellte.',
    'Sie wünschen sich schnellere Termine und freie Arztwahl.',
    'Ihr PKV-Beitrag ist gestiegen und Sie suchen einen besseren Tarif.',
  ]}
  anliegen="angestellt"
>
  <section class="section">
    <div class="wrap leistung-split">
      <div class="leistung-text">
        <h2>Was die PKV Ihnen bietet</h2>
        <p>
          Als Privatpatient haben Sie Zugang zu Spezialisten, bekommen oft schneller einen Termin und
          eine Versorgung, die sich an Ihren Bedürfnissen orientiert.
        </p>
        <p>
          Aus über 300 Versicherern finden wir den Tarif, der zu Ihrer Lebenssituation passt:
          vom Einsteigertarif mit Selbstbeteiligung bis zum umfassenden Premiumschutz.
        </p>
      </div>

      <div>
        <h2>Was Sie davon haben</h2>
        <ul class="leistung-checks">
          <li>
            <strong>Beiträge, die planbar bleiben</strong>
            <span>Beitragsentlastung für den Ruhestand ist von Anfang an mit eingeplant.</span>
          </li>
          <li>
            <strong>Schutz nach Maß</strong>
            <span>Ambulant, stationär, Zähne: Ihr Schutz passt zu Ihrem Leben, nicht umgekehrt.</span>
          </li>
          <li>
            <strong>Sicher durch den Antrag</strong>
            <span>Sie gehen die Gesundheitsfragen nicht allein durch, damit Ihr Schutz verlässlich greift.</span>
          </li>
          <li>
            <strong>Begleitung auch danach</strong>
            <span>Jährlicher Check, Hilfe bei Erstattungen und ein neuer Tarif, wenn sich Ihr Leben ändert.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <PkvCheck />

  <Fragen />
</Leistungsseite>
