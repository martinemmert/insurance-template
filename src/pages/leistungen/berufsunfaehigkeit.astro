---
import Leistungsseite from '../../layouts/Leistungsseite.astro';
import Fragen, { type Frage } from '../../components/landing/Fragen.astro';

const fragen: Frage[] = [
  {
    frage: 'Brauche ich eine BU, wenn ich im Büro arbeite?',
    antwort:
      'Ja, auch dann ist sie sinnvoll. Zu den häufigsten Gründen für eine Berufsunfähigkeit zählen psychische Erkrankungen und Beschwerden an Rücken und Gelenken. Das kann jeden treffen, unabhängig vom Beruf.',
  },
  {
    frage: 'Gibt es nicht die gesetzliche Erwerbsminderungsrente?',
    antwort:
      'Die gibt es, sie fällt aber meist niedrig aus. Sie greift nur, wenn Sie kaum noch in irgendeinem Beruf arbeiten können, nicht schon dann, wenn Ihr eigener Beruf nicht mehr geht. Die BU ergänzt sie genau an dieser Stelle.',
  },
  {
    frage: 'Wann sollte ich eine BU abschließen?',
    antwort:
      'Am besten früh. Je jünger und gesünder Sie beim Abschluss sind, desto günstiger ist in der Regel Ihr Beitrag. Für Auszubildende und Studierende gibt es besonders günstige Einstiegstarife.',
  },
  {
    frage: 'Was kostet eine Berufsunfähigkeitsversicherung?',
    antwort:
      'Das hängt von Ihrem Alter, Beruf, Ihrer Gesundheit und der gewünschten Rente ab. Im Erstgespräch bekommen Sie konkrete Beispiele, damit Sie ein gutes Gefühl für die Größenordnung haben.',
  },
];
---

<Leistungsseite
  title="Berufsunfähigkeitsversicherung in Aschaffenburg | Helmut Emmert"
  description="Berufsunfähigkeitsversicherung mit persönlicher Beratung in Aschaffenburg. Für Angestellte, Selbstständige, Beamte und Berufseinsteiger. Erstgespräch kostenlos."
  name="Berufsunfähigkeit"
  headline="Ihr Einkommen bleibt, auch wenn Ihre Gesundheit einmal nicht mitspielt."
  lead="Mit einer Berufsunfähigkeitsversicherung sind Miete, Familie und Pläne abgesichert. So können Sie sich im Ernstfall ganz aufs Gesundwerden konzentrieren."
  situationen={[
    'Ihre Familie verlässt sich auf Ihr Einkommen.',
    'Jeden Monat sind Miete oder Kredit fällig.',
    'Sie fragen sich, ob die gesetzliche Absicherung reicht.',
  ]}
  anliegen="bu"
>
  <section class="section">
    <div class="wrap leistung-split">
      <div class="leistung-text">
        <h2>Ihre Arbeitskraft trägt Ihr Leben</h2>
        <p>
          Eine längere Krankheit oder ein Unfall kann jeden treffen. Die gesetzliche Erwerbsminderungsrente
          fällt meist niedrig aus und greift erst, wenn Sie kaum noch arbeiten können.
        </p>
        <p>
          Die Berufsunfähigkeitsversicherung zahlt Ihnen jeden Monat eine vereinbarte Rente, sobald Sie Ihren Beruf
          aus gesundheitlichen Gründen nicht mehr ausüben können. In den meisten Tarifen gilt: voraussichtlich
          mindestens sechs Monate lang zu mindestens 50 Prozent.
        </p>
      </div>

      <div>
        <h2>Was Sie davon haben</h2>
        <ul class="leistung-checks">
          <li>
            <strong>Ihr Alltag läuft weiter</strong>
            <span>Die BU-Rente deckt einen großen Teil Ihres Nettoeinkommens ab.</span>
          </li>
          <li>
            <strong>Schutz bis zur Rente</strong>
            <span>Ihre Absicherung reicht durchgehend bis zum Rentenbeginn.</span>
          </li>
          <li>
            <strong>Ihr eigener Beruf zählt</strong>
            <span>Gute Tarife verweisen Sie nicht auf einen anderen Job, den Sie theoretisch noch machen könnten.</span>
          </li>
          <li>
            <strong>Ihr Schutz wächst mit</strong>
            <span>Bei Heirat, Nachwuchs oder Gehaltssprung erhöhen Sie Ihre Rente ohne neue Gesundheitsfragen.</span>
          </li>
          <li>
            <strong>Sicher durch den Antrag</strong>
            <span>Sie gehen die Gesundheitsfragen nicht allein durch, damit Ihr Schutz später verlässlich greift.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="wrap">
      <h2>Die passende Lösung für Ihre Situation</h2>
      <ul class="leistung-cards">
        <li>
          <span class="leistung-cards__tag">Angestellte</span>
          <h3>Ihr Gehalt abgesichert</h3>
          <p>Ihr Einkommen ist Ihr wichtigster Baustein. Die BU sorgt dafür, dass er stabil bleibt.</p>
        </li>
        <li>
          <span class="leistung-cards__tag">Selbstständige</span>
          <h3>Ihr Betrieb, Ihre Sicherheit</h3>
          <p>Ohne Arbeitgeber im Rücken ist eine eigene Absicherung besonders wertvoll.</p>
        </li>
        <li>
          <span class="leistung-cards__tag">Beamte</span>
          <h3>Mit Dienstunfähigkeitsklausel</h3>
          <p>Ergänzt Ihre Versorgung, gerade in den ersten Dienstjahren.</p>
        </li>
        <li>
          <span class="leistung-cards__tag">Berufseinsteiger</span>
          <h3>Früh starten, günstig bleiben</h3>
          <p>Für Auszubildende und Studierende gibt es Einstiegstarife, die mit Ihnen mitwachsen.</p>
        </li>
      </ul>
    </div>
  </section>

  <Fragen fragen={fragen} />
</Leistungsseite>
