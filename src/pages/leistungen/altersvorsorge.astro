---
import Leistungsseite from '../../layouts/Leistungsseite.astro';
import Fragen, { type Frage } from '../../components/landing/Fragen.astro';

const fragen: Frage[] = [
  {
    frage: 'Ab wann sollte ich mit der Altersvorsorge anfangen?',
    antwort:
      'So früh wie möglich, denn je mehr Zeit Ihr Geld hat, desto mehr kann es wachsen. Aber auch mit 50 lohnt sich ein guter Plan. Gemeinsam schauen wir, was in Ihrer Situation am meisten bewirkt.',
  },
  {
    frage: 'Ich habe schon Verträge. Lohnt sich trotzdem ein Gespräch?',
    antwort:
      'Ja, sehr. Sie bekommen einen Überblick über alles, was Sie schon haben, und wissen danach, ob es noch zu Ihren Plänen passt.',
  },
  {
    frage: 'Welche Form der Vorsorge ist die beste?',
    antwort:
      'Das hängt davon ab, ob Sie angestellt oder selbstständig sind, wie viel Sie verdienen und wie flexibel Sie bleiben möchten. Oft ist eine Kombination aus mehreren Bausteinen die beste Lösung.',
  },
  {
    frage: 'Was kostet das Erstgespräch?',
    antwort: 'Nichts. 15 Minuten, per Telefon oder Video, ohne Verpflichtung.',
  },
];
---

<Leistungsseite
  title="Altersvorsorge in Aschaffenburg | Helmut Emmert"
  description="Persönliche Beratung zur Altersvorsorge in Aschaffenburg: Basisrente, betriebliche Altersvorsorge und private Rentenversicherung. Erstgespräch kostenlos."
  name="Altersvorsorge"
  headline="Ihr Ruhestand, so wie Sie ihn sich vorstellen."
  lead="Reisen, Enkel, Garten oder einfach mehr Zeit: Mit einem klaren Plan wissen Sie, was Sie im Alter erwartet, und können sich auf diese Zeit freuen."
  situationen={[
    'Sie wissen nicht genau, wie hoch Ihre Rente einmal sein wird.',
    'Sie haben schon Verträge, aber keinen richtigen Überblick.',
    'Sie möchten vorsorgen und wissen nicht, womit Sie anfangen sollen.',
  ]}
  anliegen="altersvorsorge"
>
  <section class="section">
    <div class="wrap leistung-split">
      <div class="leistung-text">
        <h2>Klarheit statt Bauchgefühl</h2>
        <p>
          Viele ahnen, dass die gesetzliche Rente allein nicht für alle Wünsche reicht, aber kaum jemand
          weiß genau, wie viel am Ende herauskommt.
        </p>
        <p>
          Mit einem klaren Bild Ihrer Situation entsteht ein Plan, der zu Ihnen passt: verständlich,
          ohne Fachchinesisch und so flexibel, dass er Ihre Lebensveränderungen mitmacht.
        </p>
      </div>

      <div>
        <h2>Ihr Weg zum Plan</h2>
        <ul class="leistung-checks">
          <li>
            <strong>Sie bekommen einen Überblick</strong>
            <span>Gesetzliche Rente, Betriebsrente, private Verträge: alles auf einen Blick.</span>
          </li>
          <li>
            <strong>Sie kennen Ihr Ziel</strong>
            <span>Sie wissen, mit welchem Einkommen Sie im Ruhestand gut leben möchten.</span>
          </li>
          <li>
            <strong>Sie bekommen passende Bausteine</strong>
            <span>Aus über 300 Versicherern entsteht eine Vorsorge, die zu Ihnen passt.</span>
          </li>
          <li>
            <strong>Ihr Plan bleibt aktuell</strong>
            <span>Einmal im Jahr prüfen wir gemeinsam, ob er noch zu Ihrem Leben passt.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="wrap">
      <h2>Drei Wege, die sich gut ergänzen</h2>
      <ul class="leistung-cards">
        <li>
          <span class="leistung-cards__tag">Steuerlich gefördert</span>
          <h3>Basisrente</h3>
          <p>Ihre Beiträge können Sie steuerlich absetzen. Besonders interessant für Selbstständige und Gutverdienende.</p>
        </li>
        <li>
          <span class="leistung-cards__tag">Über den Arbeitgeber</span>
          <h3>Betriebliche Altersvorsorge</h3>
          <p>Sie sparen direkt aus Ihrem Bruttogehalt, oft mit einem Zuschuss Ihres Arbeitgebers.</p>
        </li>
        <li>
          <span class="leistung-cards__tag">Flexibel</span>
          <h3>Private Rentenversicherung</h3>
          <p>Lebenslange Rente oder Auszahlung auf einen Schlag: Sie entscheiden, was zu Ihren Plänen passt.</p>
        </li>
      </ul>
    </div>
  </section>

  <Fragen fragen={fragen} />
</Leistungsseite>
