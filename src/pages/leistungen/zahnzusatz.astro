---
import Leistungsseite from '../../layouts/Leistungsseite.astro';
import Fragen, { type Frage } from '../../components/landing/Fragen.astro';

const fragen: Frage[] = [
  {
    frage: 'Kann ich abschließen, wenn schon eine Behandlung ansteht?',
    antwort:
      'Bereits geplante oder angeratene Behandlungen sind in der Regel nicht versichert. Für alles, was danach kommt, gibt es trotzdem einen passenden Tarif. Am besten sprechen wir offen über Ihren Zahnstatus.',
  },
  {
    frage: 'Gibt es Wartezeiten?',
    antwort:
      'Das ist von Tarif zu Tarif verschieden. Manche Tarife leisten sofort, andere nach einigen Monaten. Gemeinsam finden wir die Variante, die zu Ihnen passt.',
  },
  {
    frage: 'Ist die professionelle Zahnreinigung dabei?',
    antwort: 'Bei vielen Tarifen ja. Ein Baustein, der sich jedes Jahr auszahlt.',
  },
];
---

<Leistungsseite
  title="Zahnzusatzversicherung in Aschaffenburg | Helmut Emmert"
  description="Zahnzusatzversicherung mit bis zu 100 % Erstattung für Zahnersatz, Implantate und professionelle Zahnreinigung. Persönliche Beratung in Aschaffenburg."
  name="Zahnzusatz"
  headline="Beim Zahnarzt entscheiden, was gut für Ihre Zähne ist."
  lead="Mit einer Zahnzusatzversicherung wählen Sie die Behandlung, die Ihnen am besten hilft. Bis zu 100 % Erstattung für Zahnersatz, Implantate und Zahnreinigung."
  situationen={[
    'Sie möchten für Kronen oder Implantate vorsorgen.',
    'Sie wünschen sich regelmäßige professionelle Zahnreinigung.',
    'Sie möchten beim Zahnarzt frei wählen, ohne an die Rechnung zu denken.',
  ]}
  anliegen="zusatz"
>
  <section class="section">
    <div class="wrap leistung-split">
      <div class="leistung-text">
        <h2>Gute Zähne sind eine Investition</h2>
        <p>
          Eine Krone kann schnell 500 Euro kosten, ein Implantat mehrere Tausend. Die gesetzliche Kasse
          übernimmt einen Teil, mit einer Zahnzusatzversicherung ist auch der Rest gut abgedeckt.
        </p>
        <p>
          Der passende Tarif richtet sich nach Ihrem Zahnstatus und Ihren Wünschen, und Sie wissen vorher
          genau, was er leistet.
        </p>
      </div>

      <div>
        <h2>Was Sie davon haben</h2>
        <ul class="leistung-checks">
          <li>
            <strong>Hohe Erstattung</strong>
            <span>Für Zahnersatz, Implantate und Inlays, damit Sie frei wählen können.</span>
          </li>
          <li>
            <strong>Schnell abgesichert</strong>
            <span>Ein Tarif mit kurzen Wartezeiten und verlässlichen Erstattungsgrenzen.</span>
          </li>
          <li>
            <strong>Prophylaxe inklusive</strong>
            <span>Professionelle Zahnreinigung ist bei vielen Tarifen dabei.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <Fragen fragen={fragen} />
</Leistungsseite>
