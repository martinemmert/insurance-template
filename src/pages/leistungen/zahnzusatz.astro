---
import Leistungsseite from '../../layouts/Leistungsseite.astro';
import Fragen, { type Frage } from '../../components/landing/Fragen.astro';

const fragen: Frage[] = [
  {
    frage: 'Kann ich abschließen, wenn schon eine Behandlung ansteht?',
    antwort:
      'Bereits geplante oder angeratene Behandlungen sind in der Regel nicht versichert. Für alles, was danach kommt, finden wir trotzdem einen passenden Tarif. Am besten sprechen wir offen über Ihren Zahnstatus.',
  },
  {
    frage: 'Gibt es Wartezeiten?',
    antwort:
      'Das ist von Tarif zu Tarif verschieden. Manche Tarife leisten sofort, andere nach einigen Monaten. Ich zeige Ihnen, welche Variante zu Ihnen passt.',
  },
  {
    frage: 'Ist die professionelle Zahnreinigung dabei?',
    antwort: 'Bei vielen Tarifen ja. Ein Baustein, der sich jedes Jahr auszahlt.',
  },
];
---

<Leistungsseite
  title="Zahnzusatzversicherung in Aschaffenburg | Helmut Emmert"
  description="Zahnzusatzversicherung mit bis zu 100 % Erstattung für Zahnersatz, Implantate und professionelle Zahnreinigung. Persönliche Beratung in Aschaffenburg."
  name="Zahnzusatz"
  headline="Zahnzusatz: Gesunde Zähne, entspannt beim Zahnarzt."
  lead="Bis zu 100 % Erstattung für Zahnersatz, Implantate und professionelle Zahnreinigung. Damit Sie sich für die beste Behandlung entscheiden können."
  anliegen="zusatz"
>
  <section class="section">
    <div class="wrap leistung-split">
      <div class="leistung-text">
        <h2>Warum sich Zahnzusatz lohnt</h2>
        <p>
          Eine Krone kann schnell 500 Euro kosten, ein Implantat mehrere Tausend. Die gesetzliche Kasse
          übernimmt davon einen Teil, mit der richtigen Zahnzusatzversicherung ist auch der Rest gut abgedeckt.
        </p>
        <p>
          Ich finde für Sie einen Tarif, der zu Ihrem Zahnstatus passt, und erkläre Ihnen verständlich,
          was er leistet.
        </p>
      </div>

      <div>
        <h2>Worauf ich für Sie achte</h2>
        <ul class="leistung-checks">
          <li>
            <strong>Hohe Erstattung</strong>
            <span>Für Zahnersatz, Implantate und Inlays, damit Sie frei wählen können.</span>
          </li>
          <li>
            <strong>Wartezeiten und Erstattungsgrenzen</strong>
            <span>Wir wählen einen Tarif, der früh und verlässlich leistet.</span>
          </li>
          <li>
            <strong>Prophylaxe inklusive</strong>
            <span>Professionelle Zahnreinigung ist bei vielen Tarifen dabei.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <Fragen fragen={fragen} />
</Leistungsseite>
