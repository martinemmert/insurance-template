---
import Leistungsseite from '../../layouts/Leistungsseite.astro';
---

<Leistungsseite
  title="Chefarzt & Zweibettzimmer in Aschaffenburg | Helmut Emmert"
  description="Wahlleistungen im Krankenhaus: Chefarztbehandlung und Zweibettzimmer. Persönliche, unabhängige Beratung in Aschaffenburg."
  name="Chefarzt & Zweibettzimmer"
  headline="Chefarzt & Zweibettzimmer: Gut aufgehoben im Krankenhaus."
  lead="Im Krankenhaus zählt Vertrauen. Mit Wahlleistungen entscheiden Sie selbst, wer Sie behandelt und wie Sie untergebracht sind."
  anliegen="zusatz"
>
  <section class="section">
    <div class="wrap leistung-split">
      <div class="leistung-text">
        <h2>Was Wahlleistungen bedeuten</h2>
        <p>
          Chefarztbehandlung heißt: Der erfahrenste Arzt der Abteilung kümmert sich persönlich um Sie.
          Gerade bei planbaren Eingriffen oder komplexen Diagnosen ist das ein gutes Gefühl.
        </p>
        <p>
          Im Ein- oder Zweibettzimmer haben Sie die Ruhe, die Sie zum Gesundwerden brauchen.
        </p>
      </div>

      <div>
        <h2>Worauf ich für Sie achte</h2>
        <ul class="leistung-checks">
          <li>
            <strong>Verlässliche Leistungen</strong>
            <span>Ich zeige Ihnen Tarife, die Wahlleistungen zuverlässig abdecken.</span>
          </li>
          <li>
            <strong>Klare Bedingungen</strong>
            <span>Wir gehen die Bedingungen gemeinsam durch, damit im Ernstfall alles reibungslos läuft.</span>
          </li>
          <li>
            <strong>Passend zu Ihrem Schutz</strong>
            <span>Die Wahlleistungen fügen sich gut in Ihre bestehende Krankenversicherung ein.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Leistungsseite>
