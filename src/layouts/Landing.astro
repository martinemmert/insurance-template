---
import '../styles/landing.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Private Krankenversicherung in Aschaffenburg | Helmut Emmert, Versicherungsmakler',
  description = 'Unabhängige Beratung zur privaten Krankenversicherung für Selbstständige, Beamte und Angestellte in Aschaffenburg. 25 Jahre Erfahrung bei Versicherern, Zugang zu über 300 Anbietern. Erstgespräch kostenlos.',
} = Astro.props;
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
